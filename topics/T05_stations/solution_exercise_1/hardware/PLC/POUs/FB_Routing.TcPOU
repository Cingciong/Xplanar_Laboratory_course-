<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Routing" Id="{e26d5852-4b45-4f51-a644-d7c673f41bdd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Routing
VAR
	eMode			: E_RoutingMode := E_RoutingMode.Alternate;	// routing mode, can be changed online
	// movers assigned to process stations 2 and 3
	// (driving there, queuing or being processed)
	nAssigned		: ARRAY[2..3] OF DINT;
	nMergeHolder	: UDINT;	// mover that may enter the merge point (station 5) now
	nRandom			: UDINT := 12345;
	// priority per mover; > 0 means it prefers station 2
	aPriority		: ARRAY[1..4] OF UINT := [1, 0, 1, 0];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SelectStation" Id="{a8d470e3-2df2-4cf4-9cc9-c8bc798385db}">
      <Declaration><![CDATA[METHOD SelectStation : UDINT
VAR_INPUT
	nMoverIndex	: UDINT;	// mover that is leaving station 1
	nLastDest	: UDINT;	// station it went to last time (0 = first time)
END_VAR
VAR
	nPreferred	: UDINT;
	nOther		: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Returns process station 2 or 3 for a mover, depending on eMode.
CASE eMode OF

E_RoutingMode.Alternate:
	// alternate: 2 -> 3 -> 2 ...
	IF nLastDest = 2 THEN
		SelectStation := 3;
	ELSIF nLastDest = 3 THEN
		SelectStation := 2;
	ELSE
		// first time: same table as the demo
		CASE nMoverIndex OF
			1: SelectStation := 3;
			2: SelectStation := 2;
			3: SelectStation := 2;
			4: SelectStation := 3;
		ELSE
			SelectStation := 2;
		END_CASE
	END_IF
	// if station 2 is busy and 3 is free, use 3
	IF SelectStation = 2 AND nAssigned[2] > 0 AND nAssigned[3] = 0 THEN
		SelectStation := 3;
	END_IF

E_RoutingMode.ByMover:
	// even movers -> station 2, odd -> station 3
	IF (nMoverIndex MOD 2) = 0 THEN
		SelectStation := 2;
	ELSE
		SelectStation := 3;
	END_IF

E_RoutingMode.FreeStation:
	// first free station; alternate if both are busy
	IF nAssigned[2] = 0 THEN
		SelectStation := 2;
	ELSIF nAssigned[3] = 0 THEN
		SelectStation := 3;
	ELSIF nLastDest = 2 THEN
		SelectStation := 3;
	ELSE
		SelectStation := 2;
	END_IF

E_RoutingMode.ShortestQueue:
	// station with fewer movers (tie -> station 2)
	IF nAssigned[3] < nAssigned[2] THEN
		SelectStation := 3;
	ELSE
		SelectStation := 2;
	END_IF

E_RoutingMode.Priority:
	// priority movers prefer station 2, others station 3;
	// if the preferred one has a queue (>= 2) and the other is free, use the other
	IF nMoverIndex >= 1 AND nMoverIndex <= 4 AND aPriority[nMoverIndex] > 0 THEN
		nPreferred := 2;
		nOther := 3;
	ELSE
		nPreferred := 3;
		nOther := 2;
	END_IF
	SelectStation := nPreferred;
	IF nAssigned[nPreferred] >= 2 AND nAssigned[nOther] = 0 THEN
		SelectStation := nOther;
	END_IF

E_RoutingMode.Random:
	// simple pseudo-random generator
	nRandom := nRandom * 1103515245 + 12345;
	IF (SHR(nRandom, 16) AND 1) = 1 THEN
		SelectStation := 3;
	ELSE
		SelectStation := 2;
	END_IF

ELSE
	SelectStation := 2;
END_CASE

nAssigned[SelectStation] := nAssigned[SelectStation] + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Release" Id="{ae08e959-8fb8-4e07-8908-3ed072a60c16}">
      <Declaration><![CDATA[METHOD Release
VAR_INPUT
	nStation	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Frees the process station after a mover has left it.
// the mover has left the process station
IF nStation >= 2 AND nStation <= 3 THEN
	IF nAssigned[nStation] > 0 THEN
		nAssigned[nStation] := nAssigned[nStation] - 1;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestMerge" Id="{326bdec6-b046-479d-9da3-47d3d3f4b8c0}">
      <Declaration><![CDATA[METHOD RequestMerge : BOOL
VAR_INPUT
	nMover	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// TRUE if this mover may enter the merge point now.
// station 5 (merge): only one mover at a time
IF nMergeHolder = 0 OR nMergeHolder = nMover THEN
	nMergeHolder := nMover;
	RequestMerge := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseMerge" Id="{5ffa7ca8-7ce7-4f69-ae02-0cc73c6a4357}">
      <Declaration><![CDATA[METHOD ReleaseMerge
VAR_INPUT
	nMover	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Gives the merge point back.
IF nMergeHolder = nMover THEN
	nMergeHolder := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{21512506-5965-4957-9f91-2a5c0e410579}">
      <Declaration><![CDATA[METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Clears all routing counters.
nAssigned[2] := 0;
nAssigned[3] := 0;
nMergeHolder := 0;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
