<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_RoutingMode" Id="{94b75d78-b96b-4c05-8590-07cb5764de9a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_RoutingMode :
(
	Alternate     := 0,	// stations 2, 3, 2, 3, ... (like the demo)
	ByMover       := 1,	// every mover has a fixed station
	FreeStation   := 2,	// the free station; alternate if both are busy
	ShortestQueue := 3,	// the station with fewer assigned movers
	Priority      := 4,	// priority movers go to station 2, others to 3
	Random        := 5	// random
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
