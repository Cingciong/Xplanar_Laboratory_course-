<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionSystem" Id="{78de72f9-d558-4c77-acdb-1b01eb58a62a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionSystem
VAR
	fbXPlanarSystem		: FB_XPlanarSystem;
	fbXPlanarMover		: ARRAY[1..maxNumMover] OF FB_XPlanarMoverStandard;
	fbTrackStandard		: ARRAY[1..maxTrackCount] OF FB_TrackStandard;	// tracks 1, 2, 3 (like the demo)
	fbRouting			: FB_Routing;
	// stations: 1-3 process, 4 switch, 5 merge, 6 6DoF motion
	aStation			: ARRAY[1..6] OF ST_Station;
	// state of each mover
	nStep				: ARRAY[1..maxNumMover] OF UDINT;
	nDest				: ARRAY[1..maxNumMover] OF UDINT;	// process station the mover drives to
	nLastDest			: ARRAY[1..maxNumMover] OF UDINT;
	nLap				: ARRAY[1..maxNumMover] OF UDINT;	// laps done by the mover
	nSub				: ARRAY[1..maxNumMover] OF UDINT;	// sub-step of the 6 DoF motion (station 6)
	bSkipS1				: ARRAY[1..maxNumMover] OF BOOL;	// mover is already past station 1 at start
	nStartupSequence	: UDINT;
	nStartingSequence	: UDINT;
	nTrackToBuild		: UDINT;
	nErrorID			: UDINT;
	nErrorStep			: UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="BuildTrack" Id="{2a74e38c-20be-4b88-896f-f68bf8c0171b}">
      <Declaration><![CDATA[METHOD BuildTrack : BOOL
VAR_INPUT
	nTrack	: UDINT;
END_VAR
VAR_INST
	fbTrackTable	: FB_TrackTable;
	nBuildStep		: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Builds the geometry of one track from points.
CASE nBuildStep OF
	0:	// empty point table
		IF fbTrackTable.ClearTrackTable() THEN
			nBuildStep := 10;
		END_IF

	10:	// track points (Line_Start -> Line_End; corners are calculated by the system)
		CASE nTrack OF
			1:	// left loop: stations 1 and 5
				fbTrackTable.AddPoint(E_PointType.Line_Start, E_PointOption.none, 480.0, 120.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_End,   E_PointOption.none, 240.0, 120.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_Start, E_PointOption.none, 120.0, 240.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_End,   E_PointOption.none, 120.0, 480.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_Start, E_PointOption.none, 240.0, 600.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_End,   E_PointOption.none, 480.0, 600.0, 0.0);
			2:	// middle section: station 2
				fbTrackTable.AddPoint(E_PointType.Line_Start, E_PointOption.none, 600.0, 480.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_End,   E_PointOption.none, 600.0, 240.0, 0.0);
			3:	// right loop: station 3
				fbTrackTable.AddPoint(E_PointType.Line_Start, E_PointOption.none, 480.0, 600.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_End,   E_PointOption.none, 720.0, 600.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_Start, E_PointOption.none, 840.0, 480.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_End,   E_PointOption.none, 840.0, 240.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_Start, E_PointOption.none, 720.0, 120.0, 0.0);
				fbTrackTable.AddPoint(E_PointType.Line_End,   E_PointOption.none, 480.0, 120.0, 0.0);
		END_CASE
		// tracks 2 and 3 start at the end of track 1 (switch) and end at its start (merge)
		IF nTrack > 1 THEN
			fbTrackTable.P_StartFromTrack := fbTrackStandard[1];
			fbTrackTable.P_EndAtTrack     := fbTrackStandard[1];
		END_IF
		fbTrackTable.P_CloseTheLoop := FALSE;
		nBuildStep := 20;

	20:	// check the point table
		IF fbTrackTable.CheckTrackTable() <> 0 THEN
			IF fbTrackTable.P_TrackTableCheckResult THEN
				nBuildStep := 30;
			ELSE
				nErrorStep := 20 + nTrack * 1000;
				nBuildStep := 900;
			END_IF
		END_IF

	30:	// build the track
		IF fbTrackStandard[nTrack].BuildTrackExt(fbTrackTable) THEN
			nBuildStep := 31;
		END_IF
	31:	IF fbTrackStandard[nTrack].P_BuildTrackExt.Done THEN
			nBuildStep := 100;
		ELSIF fbTrackStandard[nTrack].P_BuildTrackExt.Error THEN
			nErrorID := fbTrackStandard[nTrack].P_BuildTrackExt.ErrorID;
			nErrorStep := 31 + nTrack * 1000;
			nBuildStep := 900;
		END_IF

	100: BuildTrack := TRUE;
		nBuildStep := 0;

	900: ;	// track build error: see nErrorID, nErrorStep
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cycle" Id="{9e307b01-3109-4d84-8deb-dd2ce52af845}">
      <Declaration><![CDATA[METHOD Cycle
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Call every PLC cycle: updates the XPlanar system and the movers.
fbXPlanarSystem.Cycle();
FOR i := 1 TO moverCount DO
	fbXPlanarMover[i].Cycle();
END_FOR
FOR i := 1 TO maxTrackCount DO
	fbTrackStandard[i].Cycle();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{3117dcb1-b0b9-4e53-b565-312179b3da7e}">
      <Declaration><![CDATA[METHOD Execute
VAR
	i		: UDINT;
	fDx		: LREAL;
	fDy		: LREAL;
END_VAR
VAR_INST
	fVelo	: LREAL := 300;		// velocity [mm/s]
	fAcc	: LREAL := 1000;	// acceleration [mm/s2]
	fJerk	: LREAL := 10000;	// jerk [mm/s3]
	fGap	: LREAL := 240;		// gap between movers on a track [mm]
	fRotVel	: LREAL := 720;		// rotation velocity [deg/s]
	fRotAcc	: LREAL := 1800;
	fRotJerk: LREAL := 9000;
	stRot	: ST_MoveCOptions;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The exercise motion, called every cycle after start-up.
stRot.additionalTurns := 0;
stRot.direction := Tc3_Mc3PlanarMotion.MC_DIRECTION.mcDirectionNonModulo;

FOR i := 1 TO moverCount DO
	CASE nStep[i] OF

		// ---------------- STATION 1 (process): drive in and rotate ----------------
		10:	// first lap: a mover already past station 1 skips it
			// (the track is open and other movers are ahead, so it cannot drive back)
			IF nLap[i] = 0 AND fbXPlanarMover[i].P_ActPosition.y > aStation[1].fY THEN
				bSkipS1[i] := TRUE;
				nStep[i] := 30;
			ELSE
				fbXPlanarMover[i].MoveOnTrack('S1: approach', fbTrackStandard[aStation[1].nTrack], aStation[1].fPosOnTrack,
					fVelo, fAcc, fJerk, fGap, Tc3_Mc3PlanarMotion.MC_DIRECTION.mcDirectionPositive);
				nStep[i] := 11;
			END_IF
		11:	IF fbXPlanarMover[i].P_MoveOnTrack.Done THEN
				nStep[i] := 20;
			ELSIF fbXPlanarMover[i].P_MoveOnTrack.Error THEN
				nErrorID := fbXPlanarMover[i].P_MoveOnTrack.ErrorID;
				nStep[i] := 900;
			END_IF
		20:	IF NOT fbXPlanarMover[i].P_MoveC.Busy THEN
				fbXPlanarMover[i].MoveC('S1: rotate', 90.0, fRotVel, fRotAcc, fRotAcc, fRotJerk, stRot);
				nStep[i] := 21;
			END_IF
		21:	IF fbXPlanarMover[i].P_MoveC.Done THEN
				nStep[i] := 30;
			ELSIF fbXPlanarMover[i].P_MoveC.Error THEN
				nErrorID := fbXPlanarMover[i].P_MoveC.ErrorID;
				nStep[i] := 900;
			END_IF

		// ---------------- routing: choose the next station ----------------
		30:	nDest[i] := fbRouting.SelectStation(i, nLastDest[i]);
			nLastDest[i] := nDest[i];
			IF bSkipS1[i] THEN
				// already past station 1: go through the switch (station 4) to the chosen station
				bSkipS1[i] := FALSE;
				nStep[i] := 40;
			ELSE
				nStep[i] := 31;
			END_IF

		// after processing, drive on track 1 towards the switch (station 4)
		31:	fbXPlanarMover[i].MoveOnTrack('S1: leave', fbTrackStandard[aStation[1].nTrack], aStation[1].fSendAway,
				fVelo, fAcc, fJerk, fGap, Tc3_Mc3PlanarMotion.MC_DIRECTION.mcDirectionPositive);
			nStep[i] := 32;
		32:	IF fbXPlanarMover[i].P_MoveOnTrack.Active OR fbXPlanarMover[i].P_MoveOnTrack.Done THEN
				nStep[i] := 33;
			ELSIF fbXPlanarMover[i].P_MoveOnTrack.Error THEN
				nErrorID := fbXPlanarMover[i].P_MoveOnTrack.ErrorID;
				nStep[i] := 900;
			END_IF

		// ---------------- STATION 4 (switch): take over the mover before the switch ----------------
		33:	IF fbXPlanarMover[i].P_LastKnownTrackOID = fbTrackStandard[1].P_OID THEN
				// squared distance from the mover to the switch
				fDx := fbXPlanarMover[i].P_ActPosition.x - aStation[4].fX;
				fDy := fbXPlanarMover[i].P_ActPosition.y - aStation[4].fY;
				IF (fDx * fDx + fDy * fDy) < (aStation[4].fSendAwayDist * aStation[4].fSendAwayDist) THEN
					nStep[i] := 40;
				END_IF
			END_IF

		// send the mover to the track of the chosen station (2 or 3)
		40:	fbXPlanarMover[i].MoveOnTrack('S4: to station', fbTrackStandard[aStation[nDest[i]].nTrack], aStation[nDest[i]].fPosOnTrack,
				fVelo, fAcc, fJerk, fGap, Tc3_Mc3PlanarMotion.MC_DIRECTION.mcDirectionPositive);
			nStep[i] := 41;
		41:	IF fbXPlanarMover[i].P_MoveOnTrack.Done THEN
				nStep[i] := 50;
			ELSIF fbXPlanarMover[i].P_MoveOnTrack.Error THEN
				nErrorID := fbXPlanarMover[i].P_MoveOnTrack.ErrorID;
				nStep[i] := 900;
			END_IF

		// ---------------- STATION 2 or 3 (process): rotate 180 deg ----------------
		50:	IF NOT fbXPlanarMover[i].P_MoveC.Busy THEN
				fbXPlanarMover[i].MoveC('S2/S3: rotate', 180.0, fRotVel, fRotAcc, fRotAcc, fRotJerk, stRot);
				nStep[i] := 51;
			END_IF
		51:	IF fbXPlanarMover[i].P_MoveC.Done THEN
				nStep[i] := 60;
			ELSIF fbXPlanarMover[i].P_MoveC.Error THEN
				nErrorID := fbXPlanarMover[i].P_MoveC.ErrorID;
				nStep[i] := 900;
			END_IF

		// ---------------- STATION 5 (merge): wait for permission to enter ----------------
		60:	IF fbRouting.RequestMerge(i) THEN
				// process station is free again
				fbRouting.Release(nDest[i]);
				fbXPlanarMover[i].MoveOnTrack('S5: merge', fbTrackStandard[aStation[6].nTrack], aStation[6].fPosOnTrack,
					fVelo, fAcc, fJerk, fGap, Tc3_Mc3PlanarMotion.MC_DIRECTION.mcDirectionPositive);
				nStep[i] := 61;
			END_IF
		61:	IF fbXPlanarMover[i].P_LastKnownTrackOID = fbTrackStandard[aStation[5].nTrack].P_OID THEN
				// mover is on track 1: the next one may enter the merge point
				fbRouting.ReleaseMerge(i);
				nLap[i] := nLap[i] + 1;
				nStep[i] := 62;
			ELSIF fbXPlanarMover[i].P_MoveOnTrack.Error THEN
				nErrorID := fbXPlanarMover[i].P_MoveOnTrack.ErrorID;
				nStep[i] := 900;
			END_IF

		// ---------------- STATION 6 (6 DoF): drive in and run the motion ----------------
		62:	IF fbXPlanarMover[i].P_MoveOnTrack.Done THEN
				nSub[i] := 0;
				nStep[i] := 70;
			ELSIF fbXPlanarMover[i].P_MoveOnTrack.Error THEN
				nErrorID := fbXPlanarMover[i].P_MoveOnTrack.ErrorID;
				nStep[i] := 900;
			END_IF
		70:	IF Process6DoF(i) THEN
				nStep[i] := 10;		// mover goes back to station 1
			END_IF

		900: ;	// mover motion error: see nErrorID
	END_CASE
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitStations" Id="{f61e22df-1218-4531-86a3-25dd4a443949}">
      <Declaration><![CDATA[METHOD InitStations
VAR
	k		: UDINT;
	fPos	: PositionXYC;
	fLen	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Fills the station table (track and position of each station).
// station positions X, Y [mm] like the demo; the position on the track is calculated
aStation[1].nTrack := 1;  aStation[1].fX := 120.0;  aStation[1].fY := 360.0;  aStation[1].fSendAwayDist := 300.0;	// process 1
aStation[2].nTrack := 2;  aStation[2].fX := 600.0;  aStation[2].fY := 360.0;  aStation[2].fSendAwayDist := 5.0;	// process 2
aStation[3].nTrack := 3;  aStation[3].fX := 840.0;  aStation[3].fY := 360.0;  aStation[3].fSendAwayDist := 5.0;	// process 3
aStation[5].nTrack := 1;  aStation[5].fX := 480.0;  aStation[5].fY := 120.0;  aStation[5].fSendAwayDist := 300.0;	// merge
aStation[6].nTrack := 1;  aStation[6].fX := 240.0;  aStation[6].fY := 120.0;  aStation[6].fSendAwayDist := 5.0;	// 6 DoF motion

FOR k := 1 TO 6 DO
	IF k <> 4 THEN
		fPos.SetValuesXYC(aStation[k].fX, aStation[k].fY, 0.0);
		aStation[k].fPosOnTrack := fbTrackStandard[aStation[k].nTrack].GetTrackPositionAt(fPos);
		fLen := fbTrackStandard[aStation[k].nTrack].GetLength();
		aStation[k].fSendAway := aStation[k].fPosOnTrack + aStation[k].fSendAwayDist;
		IF aStation[k].fSendAway > fLen THEN
			aStation[k].fSendAway := fLen;
		END_IF
	END_IF
END_FOR

// station 4 is the switch at the end of track 1: movers go to track 2 or 3 there
aStation[4].nTrack := 1;
aStation[4].fX := 480.0;
aStation[4].fY := 600.0;
aStation[4].fSendAwayDist := 300.0;	// range [mm]: station 4 takes over a mover this close to the switch]]></ST>
      </Implementation>
    </Method>
    <Method Name="Process6DoF" Id="{1ef641a9-1802-472a-bc4f-6c7aa3a95996}">
      <Declaration><![CDATA[METHOD Process6DoF : BOOL
VAR_INPUT
	nMover	: UDINT;
END_VAR
VAR_INST
	stRot	: ST_MoveCOptions;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Station 6: lift, rotate C, tilt A and B, return. TRUE when finished.
stRot.additionalTurns := 0;
stRot.direction := Tc3_Mc3PlanarMotion.MC_DIRECTION.mcDirectionNonModulo;

CASE nSub[nMover] OF
    // lift Z to 4 mm
    0:  fbXPlanarMover[nMover].MoveZ('S6: Z up', 4, 20, 100, 100, 1000);
        nSub[nMover] := 1;
    1:  IF fbXPlanarMover[nMover].P_MoveZ.Done THEN
            nSub[nMover] := 10;
        ELSIF fbXPlanarMover[nMover].P_MoveZ.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveZ.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // rotate C +90 deg
    10: fbXPlanarMover[nMover].MoveC('S6: C +90', 90, 720, 1800, 1800, 9000, stRot);
        nSub[nMover] := 11;
    11: IF fbXPlanarMover[nMover].P_MoveC.Done THEN
            nSub[nMover] := 30;
        ELSIF fbXPlanarMover[nMover].P_MoveC.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveC.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // lower Z
    20: fbXPlanarMover[nMover].MoveZ('S6: Z down', 2, 20, 100, 100, 1000);
        nSub[nMover] := 21;
    21: IF fbXPlanarMover[nMover].P_MoveZ.Done THEN
            nSub[nMover] := 100;
        ELSIF fbXPlanarMover[nMover].P_MoveZ.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveZ.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // tilt A (while lifted)
    30: fbXPlanarMover[nMover].MoveA('S6: A tilt', 2, 20, 100, 100, 1000);
        nSub[nMover] := 31;
    31: IF fbXPlanarMover[nMover].P_MoveA.Done THEN
            nSub[nMover] := 40;
        ELSIF fbXPlanarMover[nMover].P_MoveA.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveA.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // tilt B
    40: fbXPlanarMover[nMover].MoveB('S6: B tilt', 2, 20, 100, 100, 1000);
        nSub[nMover] := 41;
    41: IF fbXPlanarMover[nMover].P_MoveB.Done THEN
            nSub[nMover] := 50;
        ELSIF fbXPlanarMover[nMover].P_MoveB.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveB.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // A back to 0
    50: fbXPlanarMover[nMover].MoveA('S6: A back', 0, 20, 100, 100, 1000);
        nSub[nMover] := 51;
    51: IF fbXPlanarMover[nMover].P_MoveA.Done THEN
            nSub[nMover] := 60;
        ELSIF fbXPlanarMover[nMover].P_MoveA.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveA.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // B back to 0
    60: fbXPlanarMover[nMover].MoveB('S6: B back', 0, 20, 100, 100, 1000);
        nSub[nMover] := 61;
    61: IF fbXPlanarMover[nMover].P_MoveB.Done THEN
            nSub[nMover] := 70;
        ELSIF fbXPlanarMover[nMover].P_MoveB.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveB.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // C back to 0
    70: fbXPlanarMover[nMover].MoveC('S6: C back', 0, 720, 1800, 1800, 9000, stRot);
        nSub[nMover] := 71;
    71: IF fbXPlanarMover[nMover].P_MoveC.Done THEN
            nSub[nMover] := 20;
        ELSIF fbXPlanarMover[nMover].P_MoveC.Error THEN
            nErrorStep := nSub[nMover];
            nErrorID := fbXPlanarMover[nMover].P_MoveC.ErrorID;
            nSub[nMover] := 900;
        END_IF

    // finished
    100: Process6DoF := TRUE;
        nSub[nMover] := 0;

    900: ;  // error: see nErrorStep, nErrorID
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{76b69464-5772-47f9-bff0-d287e818ff6b}">
      <Declaration><![CDATA[METHOD Starting : BOOL
VAR_INPUT
	bReset : BOOL;
END_VAR
VAR_INST
	stJoinOptions	: ST_JoinTrackOptions;
	nJoin			: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Brings the system to a ready state step by step. TRUE when done.
IF bReset THEN
	Starting := FALSE;
	nStartingSequence := 0;
END_IF
CASE nStartingSequence OF
	// start
	0:	IF NOT bReset THEN
			nStartingSequence := 102;
		END_IF

	// --- reset movers and tracks ---
	102: IF fbXPlanarSystem.ResetMovers() THEN
			nStartingSequence := 103;
		END_IF
	103: IF fbXPlanarSystem.P_ResetMovers.Done THEN
			nStartingSequence := 104;
		ELSIF fbXPlanarSystem.P_ResetMovers.Error THEN
			nErrorID := fbXPlanarSystem.P_ResetMovers.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF
	104: IF fbXPlanarSystem.ResetTracks() THEN
			nStartingSequence := 105;
		END_IF
	105: IF fbXPlanarSystem.P_ResetTracks.Done THEN
			nStartingSequence := 10;
		ELSIF fbXPlanarSystem.P_ResetTracks.Error THEN
			nErrorID := fbXPlanarSystem.P_ResetTracks.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	// --- prepare ---
	10: // enable the group (collision avoidance)
		IF fbXPlanarSystem.EnableGroup() THEN
			nStartingSequence := 11;
		END_IF
	// wait for reset
	11: IF fbXPlanarSystem.P_EnableGroup.Done THEN
			nStartingSequence := 20;
		ELSIF fbXPlanarSystem.P_EnableGroup.Error THEN
			nErrorID := fbXPlanarSystem.P_EnableGroup.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	20: // add the table borders to the group
		IF fbXPlanarSystem.AddEnvironmentToGroup() THEN
			nStartingSequence := 21;
		END_IF
	21: IF fbXPlanarSystem.P_AddEnviromentToGroup.Done THEN
			nStartingSequence := 30;
		ELSIF fbXPlanarSystem.P_AddEnviromentToGroup.Error THEN
			nErrorID := fbXPlanarSystem.P_AddEnviromentToGroup.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	30: // enable the tracks
		IF fbXPlanarSystem.EnableTracks() THEN
			nStartingSequence := 31;
		END_IF
	31: IF fbXPlanarSystem.P_EnableTracks.Done THEN
			nStartingSequence := 40;
		ELSIF fbXPlanarSystem.P_EnableTracks.Error THEN
			nErrorID := fbXPlanarSystem.P_EnableTracks.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	40: // add the tracks to the group
		IF fbXPlanarSystem.AddTracksToGroup() THEN
			nStartingSequence := 41;
		END_IF
	41: IF fbXPlanarSystem.P_AddTracksToGroup.Done THEN
			nStartingSequence := 50;
		ELSIF fbXPlanarSystem.P_AddTracksToGroup.Error THEN
			nErrorID := fbXPlanarSystem.P_AddTracksToGroup.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	50: // enable the movers
		IF fbXPlanarSystem.EnableMovers() THEN
			nStartingSequence := 51;
		END_IF
	// wait for enable
	51: IF fbXPlanarSystem.P_EnableMovers.Done THEN
			nStartingSequence := 60;
		ELSIF fbXPlanarSystem.P_EnableMovers.Error THEN
			nErrorID := fbXPlanarSystem.P_EnableMovers.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	60: // add the movers to the group
		IF fbXPlanarSystem.AddMoversToGroup() THEN
			nStartingSequence := 61;
		END_IF
	61: IF fbXPlanarSystem.P_AddMoversToGroup.Done THEN
			nStartingSequence := 70;
		ELSIF fbXPlanarSystem.P_AddMoversToGroup.Error THEN
			nErrorID := fbXPlanarSystem.P_AddMoversToGroup.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	70:	// movers join track 1 one after another
		nJoin := 1;
		stJoinOptions.useOrientation := TRUE;
		nStartingSequence := 71;
	71:	fbXPlanarMover[nJoin].JoinTrack('Join track 1', fbTrackStandard[1], 250, 1250, 12500, stJoinOptions);
		nStartingSequence := 72;
	72:	IF fbXPlanarMover[nJoin].P_JoinTrack.Done THEN
			IF nJoin < moverCount THEN
				nJoin := nJoin + 1;
				nStartingSequence := 71;
			ELSE
				nStartingSequence := 80;
			END_IF
		ELSIF fbXPlanarMover[nJoin].P_JoinTrack.Error THEN
			nErrorID := fbXPlanarMover[nJoin].P_JoinTrack.ErrorID;
			nErrorStep := nStartingSequence;
			nStartingSequence := 900;
		END_IF

	80:	// done: movers are on track 1, system ready
		FOR nJoin := 1 TO moverCount DO
			nStep[nJoin] := 10;
			nDest[nJoin] := 0;
			nLastDest[nJoin] := 0;
			nLap[nJoin] := 0;
			nSub[nJoin] := 0;
			bSkipS1[nJoin] := FALSE;
		END_FOR
		fbRouting.Reset();
		// station positions are calculated after the tracks are built, enabled and grouped
		InitStations();
		Starting := TRUE;

	900: ;	// error: see nErrorID, nErrorStep
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Startup" Id="{b507d60c-1c36-47f5-bcf3-f57938e7d9d2}">
      <Declaration><![CDATA[METHOD Startup : BOOL
VAR
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// One-time setup: register movers (and tracks) in the system. TRUE when done.
CASE nStartupSequence OF
	0:	nStartupSequence := 1;
	1:	// wait until the XPlanar system is initialized
		IF fbXPlanarSystem.P_SystemInitialized THEN
			nStartupSequence := 2;
		END_IF
	2:	// register movers and tracks in the system
		FOR i := 1 TO moverCount DO
			fbXPlanarSystem.SetMoverStandard(i, fbXPlanarMover[i]);
		END_FOR
		FOR i := 1 TO maxTrackCount DO
			fbXPlanarSystem.SetTrackStandard(i, fbTrackStandard[i]);
		END_FOR
		nTrackToBuild := 1;
		nStartupSequence := 10;
	10:	// build tracks 1, 2, 3 (track 1 first)
		IF BuildTrack(nTrackToBuild) THEN
			IF nTrackToBuild < maxTrackCount THEN
				nTrackToBuild := nTrackToBuild + 1;
			ELSE
				nStartupSequence := 20;
			END_IF
		END_IF
	20:	nStartupSequence := 30;
	30:	Startup := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>