<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_Station" Id="{41960f75-da58-4348-8554-f3043bad8b46}">
    <Declaration><![CDATA[TYPE ST_Station :
STRUCT
	nTrack			: UDINT;	// track the station is on
	fX				: LREAL;	// station position [mm]
	fY				: LREAL;
	fSendAwayDist	: LREAL;	// target after processing: distance past the station [mm]
	fPosOnTrack		: LREAL;	// station position along the track [mm]
	fSendAway		: LREAL;	// target after processing, along the track [mm]
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
