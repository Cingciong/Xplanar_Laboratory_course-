<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionSystem" Id="{76b90533-2f5f-4265-a888-7463c8f15552}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionSystem
VAR
    fbXPlanarSystem   : FB_XPlanarSystem;
    fbXPlanarMover    : ARRAY[1..maxNumMover] OF FB_XPlanarMoverStandard;
    fbTrackStandard   : ARRAY[1..maxTrackCount] OF FB_TrackStandard;  // 1 = Main, 2 = Top, 3 = Bottom
    nLoop             : ARRAY[1..maxNumMover] OF UDINT;  // loop of each mover: 2 = Top, 3 = Bottom
    nStep             : ARRAY[1..maxNumMover] OF UDINT;  // motion step of each mover
    nStartupSequence  : UDINT;
    nStartingSequence : UDINT;
    nErrorID          : UDINT;
    nErrorStep        : UDINT;   // step where the error happened
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{7a6a436f-abe3-49cf-80ba-736989644d1a}">
      <Declaration><![CDATA[METHOD Cycle
VAR
    i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Call every PLC cycle: updates the XPlanar system and the movers.
fbXPlanarSystem.Cycle();
FOR i := 1 TO moverCount DO
    fbXPlanarMover[i].Cycle();
END_FOR
FOR i := 1 TO maxTrackCount DO
    fbTrackStandard[i].Cycle();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Startup" Id="{ab1988d1-2b56-4e22-9706-835668cd8a23}">
      <Declaration><![CDATA[METHOD Startup : BOOL
VAR
    i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// One-time setup: register movers (and tracks) in the system. TRUE when done.
CASE nStartupSequence OF
    0:  nStartupSequence := 1;
    1:  // wait until the XPlanar system is initialized
        IF fbXPlanarSystem.P_SystemInitialized THEN
            nStartupSequence := 2;
        END_IF
    2:  FOR i := 1 TO moverCount DO
            fbXPlanarSystem.SetMoverStandard(i, fbXPlanarMover[i]);
        END_FOR
        FOR i := 1 TO maxTrackCount DO
            fbXPlanarSystem.SetTrackStandard(i, fbTrackStandard[i]);
        END_FOR
        nStartupSequence := 30;
    30: Startup := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{04721e65-d0d5-4973-a78a-e55f3a27c0da}">
      <Declaration><![CDATA[METHOD Starting : BOOL
VAR_INPUT
    bReset : BOOL;
END_VAR
VAR
    i : UDINT;
END_VAR
VAR_INST
    stJoinOptions : ST_JoinTrackOptions;
    bJoined       : BOOL;
    bError        : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Brings the system to a ready state step by step. TRUE when done.
IF bReset THEN
    Starting := FALSE;
    nStartingSequence := 0;
END_IF
CASE nStartingSequence OF
    // start
    0:  IF NOT bReset THEN
            nStartingSequence := 102;
        END_IF

    // --- reset movers and tracks ---
    102: IF fbXPlanarSystem.ResetMovers() THEN
            nStartingSequence := 103;
        END_IF
    103: IF fbXPlanarSystem.P_ResetMovers.Done THEN
            nStartingSequence := 104;
        ELSIF fbXPlanarSystem.P_ResetMovers.Error THEN
            nErrorID := fbXPlanarSystem.P_ResetMovers.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF
    104: IF fbXPlanarSystem.ResetTracks() THEN
            nStartingSequence := 105;
        END_IF
    105: IF fbXPlanarSystem.P_ResetTracks.Done THEN
            nStartingSequence := 10;
        ELSIF fbXPlanarSystem.P_ResetTracks.Error THEN
            nErrorID := fbXPlanarSystem.P_ResetTracks.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF

    // --- prepare ---
    10: // enable the group (collision avoidance)
        IF fbXPlanarSystem.EnableGroup() THEN
            nStartingSequence := 11;
        END_IF
    // wait for reset
    11: IF fbXPlanarSystem.P_EnableGroup.Done THEN
            nStartingSequence := 20;
        ELSIF fbXPlanarSystem.P_EnableGroup.Error THEN
            nErrorID := fbXPlanarSystem.P_EnableGroup.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF

    20: // add the table borders to the group
        IF fbXPlanarSystem.AddEnvironmentToGroup() THEN
            nStartingSequence := 21;
        END_IF
    21: IF fbXPlanarSystem.P_AddEnviromentToGroup.Done THEN
            nStartingSequence := 30;
        ELSIF fbXPlanarSystem.P_AddEnviromentToGroup.Error THEN
            nErrorID := fbXPlanarSystem.P_AddEnviromentToGroup.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF

    30: // enable the tracks
        IF fbXPlanarSystem.EnableTracks() THEN
            nStartingSequence := 31;
        END_IF
    31: IF fbXPlanarSystem.P_EnableTracks.Done THEN
            nStartingSequence := 40;
        ELSIF fbXPlanarSystem.P_EnableTracks.Error THEN
            nErrorID := fbXPlanarSystem.P_EnableTracks.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF

    40: // add the tracks to the group
        IF fbXPlanarSystem.AddTracksToGroup() THEN
            nStartingSequence := 41;
        END_IF
    41: IF fbXPlanarSystem.P_AddTracksToGroup.Done THEN
            nStartingSequence := 50;
        ELSIF fbXPlanarSystem.P_AddTracksToGroup.Error THEN
            nErrorID := fbXPlanarSystem.P_AddTracksToGroup.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF

    50: // enable the movers
        IF fbXPlanarSystem.EnableMovers() THEN
            nStartingSequence := 51;
        END_IF
    // wait for enable
    51: IF fbXPlanarSystem.P_EnableMovers.Done THEN
            nStartingSequence := 60;
        ELSIF fbXPlanarSystem.P_EnableMovers.Error THEN
            nErrorID := fbXPlanarSystem.P_EnableMovers.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF

    60: // add the movers to the group
        IF fbXPlanarSystem.AddMoversToGroup() THEN
            nStartingSequence := 61;
        END_IF
    61: IF fbXPlanarSystem.P_AddMoversToGroup.Done THEN
            nStartingSequence := 70;
        ELSIF fbXPlanarSystem.P_AddMoversToGroup.Error THEN
            nErrorID := fbXPlanarSystem.P_AddMoversToGroup.ErrorID;
            nErrorStep := nStartingSequence;
            nStartingSequence := 900;
        END_IF

    70: // upper half of the table -> Top loop, lower half -> Bottom loop
        FOR i := 1 TO moverCount DO
            IF fbXPlanarMover[i].P_ActPosition.y > 360 THEN
                nLoop[i] := 2;
            ELSE
                nLoop[i] := 3;
            END_IF
            nStep[i] := 0;
        END_FOR
        stJoinOptions.useOrientation := TRUE;
        FOR i := 1 TO moverCount DO
            fbXPlanarMover[i].JoinTrack('Join loop', fbTrackStandard[nLoop[i]],
                250, 1250, 12500, stJoinOptions);
        END_FOR
        nStartingSequence := 71;
    71: bJoined := TRUE;
        bError := FALSE;
        FOR i := 1 TO moverCount DO
            bJoined := bJoined AND fbXPlanarMover[i].P_JoinTrack.Done;
            bError := bError OR fbXPlanarMover[i].P_JoinTrack.Error;
        END_FOR
        IF bJoined THEN
            nStartingSequence := 80;
        ELSIF bError THEN
            FOR i := 1 TO moverCount DO
                IF fbXPlanarMover[i].P_JoinTrack.Error THEN
                    nErrorID := fbXPlanarMover[i].P_JoinTrack.ErrorID;
                END_IF
            END_FOR
            nErrorStep := 71;
            nStartingSequence := 900;
        END_IF

    // ready
    80: Starting := TRUE;

    900: ;   // error: see nErrorID
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{a0a6f8fb-1829-4c8b-b2f4-3e3d1ae57563}">
      <Declaration><![CDATA[METHOD Execute
VAR
    i : UDINT;
END_VAR
VAR_INST
    fVelo : LREAL := 500;    // velocity [mm/s]
    fAcc  : LREAL := 1250;   // acceleration [mm/s2]
    fJerk : LREAL := 12500;  // jerk [mm/s3]
    fGap  : LREAL := 200;    // gap between movers, centre to centre [mm]
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The exercise motion, called every cycle after start-up.
FOR i := 1 TO moverCount DO
    CASE nStep[i] OF
        0:  // target: end of own loop (Top or Bottom), via the switch at the end of Main
            fbXPlanarMover[i].MoveOnTrack('To loop', fbTrackStandard[nLoop[i]],
                fbTrackStandard[nLoop[i]].GetLength(), fVelo, fAcc, fJerk, fGap,
                MC_DIRECTION.mcDirectionPositive);
            nStep[i] := 1;

        1:  // mover reached its loop -> next target: end of Main
            IF fbXPlanarMover[i].P_LastKnownTrackOID = fbTrackStandard[nLoop[i]].P_OID THEN
                fbXPlanarMover[i].MoveOnTrack('To main', fbTrackStandard[1],
                    fbTrackStandard[1].GetLength(), fVelo, fAcc, fJerk, fGap,
                    MC_DIRECTION.mcDirectionPositive);
                nStep[i] := 2;
            ELSIF fbXPlanarMover[i].P_MoveOnTrack.Error THEN
                nStep[i] := 900;
            END_IF

        2:  // mover is on Main again -> target its loop
            IF fbXPlanarMover[i].P_LastKnownTrackOID = fbTrackStandard[1].P_OID THEN
                nStep[i] := 0;
            ELSIF fbXPlanarMover[i].P_MoveOnTrack.Error THEN
                nStep[i] := 900;
            END_IF

        900: ;   // mover motion error
    END_CASE
END_FOR]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>