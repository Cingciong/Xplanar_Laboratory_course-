    <Method Name="SetDynamics" Id="{6fd0ae84-46aa-4fc6-a469-ba2149a60e46}">
      <Declaration><![CDATA[METHOD SetDynamics : BOOL
VAR_INPUT
	vel	: LREAL;
	acc : LREAL;
	jerk :LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
	recoverVelocity := vel;
	recoveryAcceleration := acc;
	recoveryJerk := jerk;
	
	SetDynamics := TRUE;]]></ST>
      </Implementation>
