<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_ApplicationMover" Id="{40b5c66d-1fb4-4d55-9f96-3f23301af31f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ApplicationMover IMPLEMENTS I_MoverApplication
VAR
	ipMoverStandard	: I_XPlanarMoverStandard;
	
	stProductData	: ST_ProductData;
	
	nMoverIndex		: INT;
	
	nTrackId		: UDINT;
	
	// customer Data
	bIsLoaded		: BOOL;	
		
				
END_VAR

VAR_OUTPUT
	VisuPos	: MoverVector;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{3db1001d-9da7-43c7-a358-11235832af95}">
      <Declaration><![CDATA[METHOD Cycle


VAR_INST
	nTestCounter	: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF std <> 0 THEN
	
	nTestCounter := nTestCounter +1;
	
	std.cycle();
	
	VisuPos   := std.P_ActPosition;
	VisuPos.c := std.P_RotationAngleModulo;
			
END_IF


]]></ST>
      </Implementation>
    </Method>
