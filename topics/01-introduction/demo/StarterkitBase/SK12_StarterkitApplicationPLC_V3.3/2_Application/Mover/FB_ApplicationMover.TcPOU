      <Set Name="Set" Id="{e9f36281-f830-4039-8a28-5be43aca55c3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nMoverIndex := P_MoverIndex;]]></ST>
        </Implementation>
      </Set>
    </Property>
