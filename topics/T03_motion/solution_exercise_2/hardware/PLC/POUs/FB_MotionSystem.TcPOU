<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionSystem" Id="{76b90533-2f5f-4265-a888-7463c8f15552}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionSystem
VAR
    fbXPlanarSystem   : FB_XPlanarSystem;
    fbXPlanarMover    : ARRAY[1..maxNumMover] OF FB_XPlanarMoverStandard;
    nStartupSequence  : UDINT;
    nStartingSequence : UDINT;
    nExecutingSequence : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{7a6a436f-abe3-49cf-80ba-736989644d1a}">
      <Declaration><![CDATA[METHOD Cycle
VAR
    i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbXPlanarSystem.Cycle();
FOR i := 1 TO moverCount DO
    fbXPlanarMover[i].Cycle();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Startup" Id="{ab1988d1-2b56-4e22-9706-835668cd8a23}">
      <Declaration><![CDATA[METHOD Startup : BOOL
VAR
    i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStartupSequence OF
    0:  nStartupSequence := 1;
    1:  FOR i := 1 TO moverCount DO
            fbXPlanarSystem.SetMoverStandard(i, fbXPlanarMover[i]);
        END_FOR
        nStartupSequence := 30;
    30: Startup := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{04721e65-d0d5-4973-a78a-e55f3a27c0da}">
      <Declaration><![CDATA[METHOD Starting : BOOL
VAR_INPUT
    bReset : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bReset THEN
    Starting := FALSE;
    nStartingSequence := 0;
END_IF
CASE nStartingSequence OF
    0:  nStartingSequence := 50;
    50: IF fbXPlanarSystem.EnableMovers() THEN
            nStartingSequence := 51;
        END_IF
    51: IF fbXPlanarSystem.P_EnableMovers.Done THEN
            nStartingSequence := 80;
        ELSIF fbXPlanarSystem.P_EnableMovers.Error THEN
            nStartingSequence := 90;   // blad enable
        END_IF
    80: Starting := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute6DoF" Id="{8ce13323-1410-4b2b-b91c-3d53f634fa57}">
      <Declaration><![CDATA[METHOD Execute6DoF : BOOL
VAR_INPUT
    bReset : BOOL;
END_VAR
VAR_INST
    stStartPos   : PositionXYC;
    stCenterPos  : PositionXYC;
    stRotOptions : ST_MoveCOptions;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bReset THEN
    Execute6DoF := FALSE;
    nExecutingSequence := 0;
END_IF

CASE nExecutingSequence OF
    0:  // zapamietaj pozycje startowa movera 1 i przygotuj punkty
        stStartPos.SetValuesXYC(fbXPlanarMover[1].P_ActPosition.x,
                                fbXPlanarMover[1].P_ActPosition.y,
                                fbXPlanarMover[1].P_ActPosition.c);
        stCenterPos.SetValuesXYC(480, 360, 0);   // srodek stolu 4x3 kafelki
        stRotOptions.additionalTurns := 0;
        stRotOptions.direction := Tc3_Mc3PlanarMotion.MC_Direction.mcDirectionNonModulo;
        IF NOT bReset THEN
            nExecutingSequence := 10;
        END_IF

    10: // dojazd do srodka stolu
        fbXPlanarMover[1].MoveToPosition('To center', stCenterPos, 500, 1250, 1250, 12500);
        nExecutingSequence := 11;
    11: IF fbXPlanarMover[1].P_MoveToPosition.Done THEN
            nExecutingSequence := 20;
        ELSIF fbXPlanarMover[1].P_MoveToPosition.Error THEN
            nExecutingSequence := 900;
        END_IF

    20: // Z w gore na 4 mm
        fbXPlanarMover[1].MoveZ('Z up', 4, 20, 100, 100, 1000);
        nExecutingSequence := 21;
    21: IF fbXPlanarMover[1].P_MoveZ.Done THEN
            nExecutingSequence := 30;
        ELSIF fbXPlanarMover[1].P_MoveZ.Error THEN
            nExecutingSequence := 900;
        END_IF

    30: // obrot w C o +90 stopni
        fbXPlanarMover[1].MoveC('C +90', 90, 720, 1800, 1800, 9000, stRotOptions);
        nExecutingSequence := 31;
    31: IF fbXPlanarMover[1].P_MoveC.Done THEN
            nExecutingSequence := 40;
        ELSIF fbXPlanarMover[1].P_MoveC.Error THEN
            nExecutingSequence := 900;
        END_IF

    40: // Z z powrotem na normalna wysokosc
        fbXPlanarMover[1].MoveZ('Z down', 0, 20, 100, 100, 1000);
        nExecutingSequence := 41;
    41: IF fbXPlanarMover[1].P_MoveZ.Done THEN
            nExecutingSequence := 50;
        ELSIF fbXPlanarMover[1].P_MoveZ.Error THEN
            nExecutingSequence := 900;
        END_IF

    50: // przechyl A
        fbXPlanarMover[1].MoveA('A tilt', 5, 20, 100, 100, 1000);
        nExecutingSequence := 51;
    51: IF fbXPlanarMover[1].P_MoveA.Done THEN
            nExecutingSequence := 60;
        ELSIF fbXPlanarMover[1].P_MoveA.Error THEN
            nExecutingSequence := 900;
        END_IF

    60: // przechyl B
        fbXPlanarMover[1].MoveB('B tilt', 5, 20, 100, 100, 1000);
        nExecutingSequence := 61;
    61: IF fbXPlanarMover[1].P_MoveB.Done THEN
            nExecutingSequence := 70;
        ELSIF fbXPlanarMover[1].P_MoveB.Error THEN
            nExecutingSequence := 900;
        END_IF

    70: // A z powrotem na 0
        fbXPlanarMover[1].MoveA('A back', 0, 20, 100, 100, 1000);
        nExecutingSequence := 71;
    71: IF fbXPlanarMover[1].P_MoveA.Done THEN
            nExecutingSequence := 80;
        ELSIF fbXPlanarMover[1].P_MoveA.Error THEN
            nExecutingSequence := 900;
        END_IF

    80: // B z powrotem na 0
        fbXPlanarMover[1].MoveB('B back', 0, 20, 100, 100, 1000);
        nExecutingSequence := 81;
    81: IF fbXPlanarMover[1].P_MoveB.Done THEN
            nExecutingSequence := 90;
        ELSIF fbXPlanarMover[1].P_MoveB.Error THEN
            nExecutingSequence := 900;
        END_IF

    90: // C z powrotem na 0
        fbXPlanarMover[1].MoveC('C back', 0, 720, 1800, 1800, 9000, stRotOptions);
        nExecutingSequence := 91;
    91: IF fbXPlanarMover[1].P_MoveC.Done THEN
            nExecutingSequence := 100;
        ELSIF fbXPlanarMover[1].P_MoveC.Error THEN
            nExecutingSequence := 900;
        END_IF

    100: // powrot do zapisanej pozycji startowej
        fbXPlanarMover[1].MoveToPosition('Back to start', stStartPos, 500, 1250, 1250, 12500);
        nExecutingSequence := 101;
    101: IF fbXPlanarMover[1].P_MoveToPosition.Done THEN
            nExecutingSequence := 110;
        ELSIF fbXPlanarMover[1].P_MoveToPosition.Error THEN
            nExecutingSequence := 900;
        END_IF

    110: // koniec sekwencji
        Execute6DoF := TRUE;

    900: ;   // blad ruchu --- sekwencja zatrzymana
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>