  <POU Name="FB_StationBase" Id="{2d0c860d-5211-414b-ba0b-04cb8f828be8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationBase IMPLEMENTS I_Station


VAR
	stMoveParameters 	: ST_MoveOnTrackOptions; 	
	stStationPosition	: ST_StationPosition;	
	eProcessMode		: E_ProcessMode;
	StationPosition     : PositionXYC;	
	
	idx  				: UDINT;
	nStateInit			: UDINT;
	nStateClear 		: UDINT;
	nStateProcess		: UDINT;
	bStationInitDone	: BOOL;	
	
	
	// Lists for Stations
	fbList_Station		: FB_List;
	fbList_InputA		: FB_List;		
	fbList_InputB		: FB_List;	
	fbList_InputC		: FB_List;		

	
	// History info for debugging purpose
	strInfo				: STRING;	
	fbHistoryInfo		: FB_HistoryInfo;	
	
	
	nProcessRequest		: DINT;
	nProcessClearence	: DINT;
	nProcessState		: DINT;
	
	fStationPositionOnTrack		: LREAL;	
END_VAR



]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Properties" Id="{fd0777f5-fc91-4b83-836b-3df138db01e0}" />
    <Method Name="Clear" Id="{4c408367-064c-402d-970b-be8f83eec97f}">
      <Declaration><![CDATA[METHOD Clear : BOOL
VAR_INPUT
END_VAR


VAR_INST

	nStateClear : UINT;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

	CASE nStateClear OF 
		
	0:	// Enter
		            Clear := FALSE;
		  nProcessRequest := 0;
		nProcessClearence := 0;
		    nProcessState := 0;	  
			  
		nStateClear := nStateClear +10;
		
	10: // Clear Station-List
		IF fbList_Station.ClearList() THEN
			nStateClear := nStateClear +10;	
		END_IF
		
	20: // Clear InputA-List
		IF fbList_InputA.ClearList() THEN
			nStateClear := nStateClear +10;	
		END_IF
	
	30: // Clear InputB-List
		IF fbList_InputB.ClearList() THEN
			nStateClear := nStateClear +10;	
		END_IF	
	
	40: // Clear InputC-List
		IF fbList_InputB.ClearList() THEN
			nStateClear := nStateClear +10;	
		END_IF		
	
	50:	nStateClear := 100;	
		
		
	100:  // Done
		nStateClear := 0;
		      Clear := TRUE;
		
	END_CASE
	


	
]]></ST>
      </Implementation>
    </Method>
