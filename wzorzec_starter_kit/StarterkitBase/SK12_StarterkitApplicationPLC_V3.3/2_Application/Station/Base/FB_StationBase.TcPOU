END_VAR


VAR_INST
	
	fTestValueX	: LREAL;
	fTestValueY : LREAL;	
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[;


	
	
	

	
	
	
	
	
	
	
	
	
	
	
	
	
	
	]]></ST>
      </Implementation>
    </Method>
