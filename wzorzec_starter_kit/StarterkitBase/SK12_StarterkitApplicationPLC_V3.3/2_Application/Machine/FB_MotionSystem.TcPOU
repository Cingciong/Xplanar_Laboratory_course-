<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_MotionSystem" Id="{c68ba1aa-d99a-41ec-bf62-e008962e2939}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionSystem IMPLEMENTS I_MotionSystemApplication

VAR
	
	ipMotionSystem			: I_MotionSystem;
	stMoverDetectionInfos   : ST_TcIoMoverDetectionInfos;
	
	// Sequences
	nStartupSequence 		: DINT;
	nAbortingSequence 		: DINT;
	nPrepareSequence 		: DINT;
	nResettingSequence 		: DINT;
	nExecutingSequence 		: DINT;	
	
	// Helper
	bDone 					: BOOL;
	idx						: UDINT;
	nForCounter 			: UDINT;	
	nErrorID				: UDINT;
	bMoverError				: BOOL;	

	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Methods" Id="{91e35361-bc44-45dd-a128-86c46caaf17a}" />
    <Folder Name="Properties" Id="{efa9f437-f192-4201-98d8-01b3ba472d58}" />
    <Folder Name="StateMachine" Id="{7f5f3f66-f754-42e6-b79a-2d35cb228eb0}" />
    <Method Name="Aborting" Id="{9ccf5fae-fdd4-4e5e-a1a1-553ef638d975}" FolderPath="StateMachine\">
      <Declaration><![CDATA[METHOD Aborting : BOOL
VAR_INST
	bWaitForRotatioFinished		: BOOL;
END_VAR



]]></Declaration>
      <Implementation>
        <ST><![CDATA[
nErrorID := 0;

CASE nAbortingSequence OF 

	0: // Enter	
		bWaitForRotatioFinished := FALSE;
		FOR idx:=1 TO g_nMoverCount DO
			IF ipMoverApplication[idx].std.P_MoveC.Busy THEN
				bWaitForRotatioFinished := TRUE;	
			END_IF
		END_FOR
		
		IF NOT bWaitForRotatioFinished THEN
			nAbortingSequence := 10; 
		ELSE
			ipVisuMessage.SetInfoMessage('Waiting for rotation finished', 'Aborting', nAbortingSequence);	
		END_IF			
		
		
	10: // Sending "Halt" to all movers for immediate stop 
		IF ipMotionSystem.HaltSystem() THEN
			ipVisuMessage.SetInfoMessage('Sending HALT', 'Aborting', nAbortingSequence);
			nAbortingSequence := nAbortingSequence +1;
		END_IF
		
	11: IF ipMotionSystem.P_HaltSystem.Done THEN
			nAbortingSequence := nAbortingSequence +9;
		ELSIF ipMotionSystem.P_HaltSystem.Error THEN
			nAbortingSequence := nAbortingSequence +1;				
		END_IF
	
	12:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_HaltSystem.ErrorID;
		IF nErrorID = 33105 THEN
			nAbortingSequence := nAbortingSequence +8;
		ELSE
			ipVisuMessage.SetErrorMessage('HALT failed', 'Aborting', nAbortingSequence, nErrorID);
		END_IF
				

		
	20: // Reset Movers
		IF ipMotionSystem.ResetMovers() THEN
			ipVisuMessage.SetInfoMessage('RESET Movers', 'Aborting', nAbortingSequence);
			nAbortingSequence := nAbortingSequence +1;				
		END_IF
		
	21: IF ipMotionSystem.P_ResetMovers.Done THEN
			nAbortingSequence := nAbortingSequence +9;
		ELSIF ipMotionSystem.P_ResetMovers.Error THEN
			nAbortingSequence := nAbortingSequence +1;		
		END_IF

	22:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_ResetMovers.ErrorID;			
		ipVisuMessage.SetErrorMessage('RESET failed', 'Aborting', nAbortingSequence, nErrorID);			
		
		
	30: // Disable all movers	
		IF ipMotionSystem.DisableMovers() THEN
			ipVisuMessage.SetInfoMessage('DISABLE Movers', 'Aborting', nAbortingSequence);
			nAbortingSequence := nAbortingSequence +1;
		ELSE
			nAbortingSequence := nAbortingSequence +5;
		END_IF
		
	31: IF ipMotionSystem.P_DisableMovers.Done THEN
			nAbortingSequence := nAbortingSequence +9;
					
		ELSIF ipMotionSystem.P_DisableMovers.Error THEN
			nAbortingSequence := nAbortingSequence +1;					
		END_IF

	32:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_DisableMovers.ErrorID;	
		ipVisuMessage.SetErrorMessage('DISABLE failed', 'Aborting', nAbortingSequence, nErrorID);	
		
		
		
	40:	// Remove Tracks from Group
		IF ipMotionSystem.RemoveTracksFromGroup() THEN
			ipVisuMessage.SetInfoMessage('REMOVE TRACKS FROM GROUP', 'Aborting', nAbortingSequence);
			nAbortingSequence := nAbortingSequence +1;
		END_IF	

	41: IF ipMotionSystem.P_RemoveTracksFromGroup.Done THEN
			nAbortingSequence := nAbortingSequence +9;
		ELSIF ipMotionSystem.P_RemoveTracksFromGroup.Error THEN
			nAbortingSequence := nAbortingSequence +1;	
		END_IF
		
	42:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_RemoveTracksFromGroup.ErrorID;
		ipVisuMessage.SetErrorMessage('REMOVE TRACKS FROM GROUP failed', 'Aborting', nAbortingSequence, nErrorID);			
		
		
		
	50: // Remove Environment from Group
		IF ipMotionSystem.RemoveEnvironmentFromGroup() THEN
			ipVisuMessage.SetInfoMessage('REMOVE ENVIRONMENT FROM GROUP', 'Aborting', nAbortingSequence);
			nAbortingSequence := nAbortingSequence +1;
		END_IF	
		
	51: IF ipMotionSystem.P_RemoveEnviromentFromGroup.Done THEN
			nAbortingSequence := nAbortingSequence +9;
		ELSIF ipMotionSystem.P_RemoveEnviromentFromGroup.Error THEN
			nAbortingSequence := nAbortingSequence +1;				
		END_IF		

	52:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_RemoveEnviromentFromGroup.ErrorID;	
		ipVisuMessage.SetErrorMessage('REMOVE ENVIRONMENT FROM GROUP failed', 'Aborting', nAbortingSequence, nErrorID);			
		
		
		
	60: // Disable group
		IF ipMotionSystem.DisableGroup() THEN
			ipVisuMessage.SetInfoMessage('DISABLE GROUP', 'Aborting', nAbortingSequence);
			nAbortingSequence := nAbortingSequence +1;
		END_IF

	61: IF ipMotionSystem.P_DisableGroup.Done THEN
			nAbortingSequence := nAbortingSequence +9;
		ELSIF ipMotionSystem.P_DisableGroup.Error THEN
			nAbortingSequence := nAbortingSequence +1;					
		END_IF		
	
	62:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_DisableGroup.ErrorID;
		ipVisuMessage.SetErrorMessage('DISABLE GROUP failed', 'Aborting', nAbortingSequence, nErrorID);		


		
	70: // Disable all tracks
		IF ipMotionSystem.DisableTracks() THEN
			ipVisuMessage.SetInfoMessage('DISABLE TRACKS', 'Aborting', nAbortingSequence);
			nAbortingSequence := nAbortingSequence +1;
		END_IF
		
	71:	IF ipMotionSystem.P_DisableTracks.Done THEN
			nAbortingSequence := nAbortingSequence +9;
		ELSIF ipMotionSystem.P_DisableTracks.Error THEN
			nAbortingSequence := nAbortingSequence +1;
		END_IF
	
	72:	nErrorID := ipMotionSystem.P_DisableTracks.ErrorID;
		ipVisuMessage.SetErrorMessage('DISABLE TRACKS failed', 'Aborting', nAbortingSequence, nErrorID);	


	80:	nAbortingSequence := 100;


		
	100: // Reset of all sequences / Aborting done
		ipVisuMessage.SetInfoMessage('ABORTING finished', 'Aborting', 0);
	
		nAbortingSequence  := 0;
		nResettingSequence := 0;
		nPrepareSequence   := 0;
		nExecutingSequence := 0;
		          Aborting := TRUE;
				  
 		  
END_CASE


	ipVisuMessage.StateUpdate(nAbortingSequence, 'Aborting');












]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cycle" Id="{1b98e8cd-c360-43d4-9175-089db5478f78}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Cycle : BOOL
VAR_INPUT
END_VAR


VAR_INST
	nMoverIndex	: UDINT;
	nTestCnt	: UINT;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[
	nTestCnt := nTestCnt +1;


	// Keeping the std cycle alive
	IF THIS^.std <> 0 THEN
		THIS^.std.Cycle();
	END_IF



	// Scanning for mover error e.g. Following Error
	bMoverError := FALSE;
	FOR nMoverIndex:=1 TO g_nMoverCount DO	
		IF ipMoverApplication[nMoverIndex] <> 0 THEN
			IF ipMoverApplication[nMoverIndex].std.P_State = MC_PLANAR_STATE.Error THEN
				bMoverError := TRUE;	
			END_IF
		END_IF
	END_FOR





	
	
	
	
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{f53cf4b4-169a-4ddf-be8c-a6508e61f5bb}" FolderPath="StateMachine\">
      <Declaration><![CDATA[METHOD Execute : UDINT



]]></Declaration>
      <Implementation>
        <ST><![CDATA[
	CASE nExecutingSequence OF
		
	
	0:	// Enter
		ipVisuMessage.ClearAllMessages();
		nExecutingSequence := 10;
	
	
	10: // Setting all stations into production mode
		FOR idx:=1 TO gc_NumberStations DO
			ipStation[idx].P_eProcessMode := E_ProcessMode.Production;
		END_FOR
		nExecutingSequence := 100;
		
		
		
	100: // Execution	
		;
	

	END_CASE
	
	
	
	
	




]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoverPreparation" Id="{ebe3098c-1879-46fd-949c-cfb999e18a1e}">
      <Declaration><![CDATA[METHOD MoverPreparation : BOOL
VAR_INPUT
	bReset 	: BOOL;
END_VAR


VAR_INST
	
	nStatePreparation		: DINT;
	
	
	operationMode				: XPlanarOperationMode; 
	
	idx2						: UDINT;

	nTileDcLinkVoltage			: UINT;
	bTilePowerOK				: BOOL;
	bTilePowerOverview			: ARRAY[1..gc_MaxNumberTiles] OF BOOL;
	bPowerOK					: BOOL;
	bPowerMissing				: BOOL;
	nTileCount					: UDINT;
	nTileToCheck				: UINT;
	bWithBumperID				: BOOL;	
	nMoverAccessoryIdCount		: ARRAY[1..gc_nMaxNumberMovers] OF UDINT;	
	
	stStartCheck 				: ST_CheckStartConditionFeedback;
	nLimitExceeded_MoverID		: UDINT;
	bLimitExceeded_Angle 		: BOOL;
	bLimitExceeded_PositionX 	: BOOL;
	bLimitExceeded_PositionY 	: BOOL;	
	fCurrentAngleDeviation		: LREAL;
	fCurrentPositionDeviationX	: LREAL;
	fCurrentPositionDeviationY	: LREAL;	

	sTextTemp					: STRING;

	eMoverAccessoryID			: MoverAccessoryID;

	
	moverCoordComStatus			: CoordinatedMoverCommStatus;
	moverComStatus				: MoverCommunicationStatus;
	
	bMoverCommunicationProblem  : ARRAY[1..gc_nMaxNumberMovers] OF BOOL;
	bCommunicationProblem		: BOOL;
	
	nMoverToCorrect				: UDINT;
	fMoverOrientationRead		: LREAL;
	fMoverOrientationCorrect	: LREAL;
	bDoRotationCorrection		: BOOL;
	CorrectionPos				: PositionXYC;
	
	bDeterminedMoverID				: BOOL;
	bDerterminedMoverOrientation 	: BOOL;
	
	fPosX							: LREAL;
	fPosY							: LREAL;
	fPosC							: LREAL;
	
	nCommunicationRetryCounter		: UINT;
	
	nMoverToCheck					: UINT;
	
	nMoverID_ErrorCode				: DWORD;
	
	MoverType						: XPlanarMoverType;
	bMoverCanDeterminOrientation	: BOOL;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bReset THEN
	nStatePreparation := 0;
	MoverPreparation := TRUE;
END_IF


	CASE nStatePreparation OF
		
	0:  nStatePreparation := 10;
	

	10: // 1st: Check if the system is in simulation mode or not
		// Simulation > OperationMode = 1
		//     Normal > OperationMode = 0
	    operationMode := ipMotionSystem.ipDriver.XpuTcIo(1).GetOperationMode();	
		IF operationMode = 0 THEN
			bPowerMissing := FALSE;
			nStatePreparation := nStatePreparation + 10;
		ELSE
			nStatePreparation := 500;
		END_IF
	
		
	20: // 2nd: Check power of each tile
		IF NOT bPowerMissing THEN
			ipVisuMessage.SetInfoMessage('Checking tile power', 'MoverPreparation', nStatePreparation);
		ELSE
			ipVisuMessage.SetErrorMessage('Tile power missing!', 'MoverPreparation', nStatePreparation, 0);	
		END_IF
		
		    bPowerOK := TRUE;
		nTileToCheck := 0;
		  nTileCount := ipMotionSystem.ipDriver.XpuTcIo(1).GetTileCount();
		
		nStatePreparation := nStatePreparation + 1;
		
	21:
		nTileToCheck := nTileToCheck +1;
		IF nTileToCheck <= nTileCount THEN
			nStatePreparation := nStatePreparation + 1;
		ELSE
			IF bPowerOK THEN
				nStatePreparation := nStatePreparation + 9;
			ELSE
				bPowerMissing := TRUE;
				nStatePreparation := nStatePreparation - 1;
			END_IF
		END_IF
		
	22:
		nTileDcLinkVoltage := ipMotionSystem.ipDriver.XpuTcIo(1).TileTcIo(1,nTileToCheck).GetActDcLinkVoltage(); 
		IF nTileDcLinkVoltage > 6000 THEN
			bTilePowerOK := TRUE;
		ELSE
			bTilePowerOK := FALSE;	
		END_IF
		bPowerOK := bPowerOK AND bTilePowerOK;
		bTilePowerOverview[nTileToCheck] := bPowerOK;
		nStatePreparation := nStatePreparation - 1;
		
		
		
	30:// 3rd: Mover re-detection, in case a mover was removed inbetween
	
		// Check if a mover has been lost...
		IF ipMotionSystem.CheckValidMovers() THEN
			ipVisuMessage.SetInfoMessage('Mover re-detection', 'MoverPreparation', nStatePreparation);
			nStatePreparation := nStatePreparation + 1;
		END_IF
	
	31:
		IF ipMotionSystem.P_CheckValidMovers.bDone THEN
			IF ipMotionSystem.P_CheckValidMovers.bMoverLost THEN
				         bDeterminedMoverID := FALSE;
				bDerterminedMoverOrientation := FALSE;
				nStatePreparation := nStatePreparation + 1;
			ELSE
				nStatePreparation := nStatePreparation + 9;
			END_IF
		END_IF
				
		bDeterminedMoverID := FALSE;
		bDerterminedMoverOrientation := FALSE;		
		
		
	32: // Starting mover re-detection
		IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN
			IF ipMotionSystem.ipDriver.XpuTcIo(1).SetStartMoverRedetection() THEN	
				nStatePreparation := nStatePreparation +1;
			END_IF
		END_IF
	
	33: // Checking if all movers have been found on the XPlanar surface
		stMoverDetectionInfos := ipMotionSystem.ipDriver.XpuTcIo(1).GetMoverDetectionInfos();
		
		IF stMoverDetectionInfos.APM4220Detected = stMoverDetectionInfos.APM4220Expected THEN
			nStatePreparation := nStatePreparation +7;
		ELSE
			sTextTemp := 'Mover Missing!  Expected:';
			sTextTemp := CONCAT(sTextTemp, UDINT_TO_STRING(stMoverDetectionInfos.APM4220Detected));
			sTextTemp := CONCAT(sTextTemp, '  Detected:');
			sTextTemp := CONCAT(sTextTemp, UDINT_TO_STRING(stMoverDetectionInfos.APM4220Detected));
			
			ipVisuMessage.SetErrorMessage(sTextTemp, 'MoverPreparation', nStatePreparation, 0);	
		END_IF
	
		
	
	 40: // 4th: Checking the position of each mover before enabeling
	 	ipVisuMessage.SetInfoMessage('Check mover position', 'MoverPreparation', nStatePreparation);
	 
		bDone := TRUE;
		FOR idx:=1 TO g_nMoverCount DO
			stStartCheck := ipMoverApplication[idx].std.CheckStartConditions();
			IF NOT stStartCheck.bPositionOK THEN
				bDone := FALSE;
				EXIT;
			END_IF			
		END_FOR
	
		IF bDone THEN
			nStatePreparation := nStatePreparation + 2;
		ELSE
			nStatePreparation := nStatePreparation + 1;
		END_IF
			
	 41: // Position-Check failed:
		 // Except for rotation-points between four quadrants the angle limit of the c-axis is +/- 10.0°
		 // At rotation-points the max position deviation is +/-1mm in x/y-direction  	
				nLimitExceeded_MoverID := stStartCheck.nMoverID;
				  bLimitExceeded_Angle := stStartCheck.bAngleLimitExceeded;
			  bLimitExceeded_PositionX := stStartCheck.bPositionXLimitExceeded;
			  bLimitExceeded_PositionY := stStartCheck.bPositionYLimitExceeded;	
				fCurrentAngleDeviation := stStartCheck.fCurrentAngleDeviation;
			fCurrentPositionDeviationX := stStartCheck.fCurrentPositionDeviationX;
			fCurrentPositionDeviationY := stStartCheck.fCurrentPositionDeviationY;
	
			sTextTemp := 'Position Check Failed! - Mover ';
			sTextTemp := CONCAT(sTextTemp, UDINT_TO_STRING(nLimitExceeded_MoverID));
			sTextTemp := CONCAT(sTextTemp, ' too far away from rotation point.');
			
			ipVisuMessage.SetErrorMessage(sTextTemp, 'MoverPreparation', nStatePreparation, 0);	
			
			nStatePreparation := nStatePreparation - 1;
			
	42:		ipVisuMessage.ClearAllMessages();
			nStatePreparation := nStatePreparation + 8;
		
		
		
	50: // 5th: Check if movers with accessory MoverID are present. If yes, do mover identification before enabeling all movers.	
		bWithBumperID := FALSE;
			
		IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN
			FOR idx:=1 TO g_nMoverCount DO
				nMoverAccessoryIdCount[idx] := ipMotionSystem.ipDriver.XpuTcIo(1).MoverTcIo(UDINT_TO_UINT(idx)).GetAccessoryIdCount();
			END_FOR
			
			FOR idx:=1 TO g_nMoverCount DO
				FOR idx2:=1 TO nMoverAccessoryIdCount[idx] DO
					eMoverAccessoryID := ipMotionSystem.ipDriver.XpuTcIo(1).MoverTcIo(UDINT_TO_UINT(idx)).GetAccessoryID(UDINT_TO_UINT(idx2));
					
					IF eMoverAccessoryID = MoverAccessoryID.APM9001_0000 THEN
						// Note: With the current driver release (3.2209.36.0) mover identification only works if all movers are equiped with ID bumpers!
						bWithBumperID := TRUE;						
					END_IF
				END_FOR
			END_FOR
		END_IF

			
		IF bWithBumperID THEN
			nStatePreparation := nStatePreparation + 10;
		ELSE
			nStatePreparation := 500;
		END_IF
		
		
	60: // 6th: Do mover identification
		ipVisuMessage.SetInfoMessage('Start mover-identification', 'MoverPreparation', nStatePreparation);
	
		IF NOT bDeterminedMoverID THEN
			IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN
				IF ipMotionSystem.ipDriver.XpuTcIo(1).SetCoordMoverCommunicationCmd(CoordinatedMoverCommCommand.IdentifyAndAssignPossible) THEN
					nStatePreparation := nStatePreparation +1;
				END_IF	
			END_IF
		ELSE
			nStatePreparation := nStatePreparation +10;
		END_IF
	
	61:
		IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN			
			moverCoordComStatus := ipMotionSystem.ipDriver.XpuTcIo(1).GetCoordMoverCommStatus();
			
			IF moverCoordComStatus = CoordinatedMoverCommStatus.CommunicationSuccessful THEN
				bDeterminedMoverID := TRUE;
				ipVisuMessage.ClearAllMessages();
				nStatePreparation := nStatePreparation + 9;	
			ELSIF moverCoordComStatus = CoordinatedMoverCommStatus.CommunicationFailed THEN
				nStatePreparation := nStatePreparation + 1;	
			END_IF
			
		END_IF
		
	62:	IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN	
			nMoverID_ErrorCode := ipMotionSystem.ipDriver.XpuTcIo(1).GetCoordMoverCommunicationErrorId();
			ipVisuMessage.SetErrorMessage('Mover Identification Failed!', 'MoverPreparation', nStatePreparation, nMoverID_ErrorCode);
		END_IF
		
		IF ipVisuMessage.CheckAknowledge()  THEN
			nStatePreparation := 0;	
		END_IF
		
		
		
	70: // 7th: Determine Mover-Orientation
	
		// Note: At the time of creation of this example code only APM4330 was able to determine its orientation.
		//       Change the code according to newer driver releases and availability of the orientation feature.
		bMoverCanDeterminOrientation := TRUE;
		FOR idx:=1 TO g_nMoverCount DO
			MoverType := ipMotionSystem.ipDriver.XpuTcIo(1).MoverTcIo(UDINT_TO_UINT(idx)).GetMoverType();
			IF MoverType <> XPlanarMoverType.APM4330 THEN
				bMoverCanDeterminOrientation := FALSE;
			END_IF
		END_FOR
			
		IF bMoverCanDeterminOrientation THEN
			IF NOT bDerterminedMoverOrientation THEN
				ipVisuMessage.SetInfoMessage('Mover orientation determination', 'MoverPreparation', nStatePreparation);
				IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN
					IF ipMotionSystem.ipDriver.XpuTcIo(1).SetCoordMoverCommunicationCmd(CoordinatedMoverCommCommand.DetermineOrientations) THEN
						nStatePreparation := nStatePreparation + 1;	
					END_IF
				END_IF
			ELSE
				nStatePreparation := nStatePreparation + 20;		
			END_IF
		ELSE
			nStatePreparation := nStatePreparation + 20;
		END_IF
	
		
	71: // Check if communication is active
		IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN
			moverCoordComStatus := ipMotionSystem.ipDriver.XpuTcIo(1).GetCoordMoverCommStatus();
			IF moverCoordComStatus = CoordinatedMoverCommStatus.CommunicationInProcess THEN
				nStatePreparation := nStatePreparation + 1;	
			END_IF
		END_IF
	
		
	72: // Wait for orientation determination finished
		IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN
			moverCoordComStatus := ipMotionSystem.ipDriver.XpuTcIo(1).GetCoordMoverCommStatus();
			IF moverCoordComStatus = CoordinatedMoverCommStatus.CommunicationSuccessful THEN
				nStatePreparation := nStatePreparation + 8;	
			ELSIF moverCoordComStatus = CoordinatedMoverCommStatus.CommunicationFailed THEN
				IF nCommunicationRetryCounter <= 5 THEN
					nCommunicationRetryCounter := nCommunicationRetryCounter +1;
					nStatePreparation := nStatePreparation - 2;	
				ELSE
					nStatePreparation := nStatePreparation + 1;	
				END_IF
			END_IF
		END_IF
		
				
	73:	// Check which movers do not communicate correctly:
		nMoverToCheck := 0;
		nStatePreparation := nStatePreparation + 1;
		
	74: nMoverToCheck := nMoverToCheck +1;
		IF nMoverToCheck <= g_nMoverCount THEN
			IF ipMotionSystem.UtilityCheckForError(bAutoReset := TRUE) > 0 THEN
				IF ipMotionSystem.ipDriver.XpuTcIo(1).MoverTcIo(nMoverToCheck).SetMoverCommunicationCommand(MoverCommunicationCommand.DetermineOrientation) THEN
					nStatePreparation := nStatePreparation + 1;
				END_IF
			END_IF
		ELSE
			FOR idx:=1 TO g_nMoverCount DO
				bCommunicationProblem := FALSE;
				IF bMoverCommunicationProblem[idx] THEN
					bCommunicationProblem := TRUE;	
				END_IF
			END_FOR
			
			IF bCommunicationProblem THEN
				sTextTemp := 'Mover Communication Problem: ';
				FOR idx:=1 TO g_nMoverCount DO
					IF bMoverCommunicationProblem[idx] THEN
						sTextTemp := CONCAT(sTextTemp, ' M');
						sTextTemp := CONCAT(sTextTemp, UDINT_TO_STRING(idx));
					END_IF
				END_FOR				
				ipVisuMessage.SetErrorMessage(sTextTemp, sTextTemp, nStatePreparation, 0);
			ELSE
				nStatePreparation := nStatePreparation - 4;	
			END_IF
		END_IF
		
	75: moverComStatus := ipMotionSystem.ipDriver.XpuTcIo(1).MoverTcIo(nMoverToCheck).GetCommunicationStatus();
		IF moverComStatus = MoverCommunicationStatus.CommunicationSuccessful THEN
			bMoverCommunicationProblem[nMoverToCheck] := FALSE;
			nStatePreparation := nStatePreparation - 1;
		ELSIF moverComStatus = MoverCommunicationStatus.CommunicationFailed THEN
			bMoverCommunicationProblem[nMoverToCheck] := TRUE;
			nStatePreparation := nStatePreparation - 1;
		END_IF
		
		
	80:	// Rotation-Angle modulo adaption
		ipVisuMessage.SetInfoMessage('Rotation-Angle modulo adaption', 'MoverPreparation', nStatePreparation);
		nMoverToCorrect := 0;
		nStatePreparation := nStatePreparation + 1;	
		
	81:	nMoverToCorrect := nMoverToCorrect +1;
		IF nMoverToCorrect <= g_nMoverCount THEN
			fMoverOrientationRead    := ipMoverApplication[nMoverToCorrect].std.P_ActPosition.c; 
			fMoverOrientationCorrect := fMoverOrientationRead;
			 bDoRotationCorrection := FALSE;
			nStatePreparation := nStatePreparation + 1;	
		ELSE
			bDerterminedMoverOrientation := TRUE;
			nStatePreparation := nStatePreparation + 9;	
		END_IF
		
	82:	IF fMoverOrientationCorrect >= 0 THEN
			IF fMoverOrientationCorrect > 360.0 THEN
				fMoverOrientationCorrect := fMoverOrientationCorrect - 180.0;
				bDoRotationCorrection := TRUE;
			ELSE
				nStatePreparation := nStatePreparation + 1;
			END_IF
		ELSE
			IF fMoverOrientationCorrect < 360.0 THEN
				fMoverOrientationCorrect := fMoverOrientationCorrect + 180.0;
				bDoRotationCorrection := TRUE;
			ELSE
				nStatePreparation := nStatePreparation + 1;
			END_IF
		END_IF			
		
		
	83:	IF bDoRotationCorrection THEN
			
			fPosX := ipMoverApplication[nMoverToCorrect].std.P_ActPosition.x;
			fPosY := ipMoverApplication[nMoverToCorrect].std.P_ActPosition.y;
			fPosC := ipMoverApplication[nMoverToCorrect].std.P_ActPosition.c;
	
			CorrectionPos.SetValuesXYC(fPosX, fPosY, fMoverOrientationCorrect);	
	
			ipMoverApplication[nMoverToCorrect].std.SetMoverPosition('Correction', CorrectionPos);
			
			nStatePreparation := nStatePreparation + 1;	
		ELSE
			nStatePreparation := nStatePreparation - 2;
		END_IF
		
	84:
		IF ipMoverApplication[nMoverToCorrect].std.P_SetMoverPosition.Done THEN
			nStatePreparation := nStatePreparation - 3;
		ELSIF ipMoverApplication[nMoverToCorrect].std.P_SetMoverPosition.Error THEN
			nErrorID := ipMoverApplication[nMoverToCorrect].std.P_SetMoverPosition.ErrorID;
			ipVisuMessage.SetErrorMessage('Rotation-Angle modulo adaption', 'MoverPreparation', nStatePreparation, nErrorID);		
		END_IF
		

	90: nStatePreparation := 500;
	
			
	500: // Done
		nStatePreparation := 0;
		MoverPreparation := TRUE;		
			
		
	END_CASE


	ipVisuMessage.StateUpdate(nStatePreparation, 'MoverPreparation');

	
	
	
	
	
	
	
	
































]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoverRecovery" Id="{11b61646-5205-4eab-b591-cdfd2d5233bf}">
      <Declaration><![CDATA[METHOD MoverRecovery : BOOL
VAR_INPUT
	bReset	: BOOL;
END_VAR



VAR_INST

	// Dynamic limitations
	fVeloRec           				: LREAL := 250.0;
	fAccelRec    					: LREAL := 3000.0;
	fJerkRec            			: LREAL := 30000.0;
	
	fVeloTurn           			: LREAL :=  1800.0;
	fAccelTurn    					: LREAL :=   720.0;
	fJerkTurn            			: LREAL := 14400.0;		
	

	idx								: UDINT;	
	nTestCounter					: UDINT;
	nStateMoverRecovery				: INT;	
	bAllMoversDone					: BOOL;
	nForCounter						: UDINT;
	bStillBusy						: BOOL;
	nInitPositionToMoveTo			: UDINT;
	bAllMoversAtInitPosition		: BOOL;
	nInitPositionIndex	  			: UDINT;
	nMoverIndex			  			: UDINT;
	nMoversToInitPositionFound		: UDINT;
	nMoverToJoinTrack				: UDINT;
	nMoverToInitPosition			: UDINT;
	bTryMoveX						: BOOL;
	bTryMoveY						: BOOL;
	nCounterMoverToMove				: INT;	
	
	fInitialMoverPosition			: ARRAY [1..gc_nMaxNumberMovers,1..2] OF LREAL;
	bMoverSortedAlready				: ARRAY [1..gc_nMaxNumberMovers] OF BOOL;
	bMoverSkipInitPosition			: ARRAY [1..gc_nMaxNumberMovers] OF BOOL;
	bMoverToInitPosition			: ARRAY [1..gc_nMaxNumberMovers] OF BOOL;
	bMoverAtInitPosition			: ARRAY [1..gc_nMaxNumberMovers] OF BOOL;
	bMoverBlockedByMove				: ARRAY [1..gc_nMaxNumberMovers] OF BOOL;
	bInitPositionBlockedByMove		: ARRAY [1..gc_nMaxNumberMovers] OF BOOL;	
	bInitialMoverPositionDone		: ARRAY [1..gc_nMaxNumberMovers] OF BOOL;
	nMoverOnTheWayToInitPosition	: ARRAY [1..gc_nMaxNumberMovers] OF UDINT;
	fMoverDistanceToInitialPosition	: ARRAY [1..gc_nMaxNumberMovers] OF LREAL;
	fShortestDistance				: ARRAY [1..gc_nMaxNumberMovers] OF LREAL;
	nClosestMoverToInitPosition		: ARRAY [1..gc_nMaxNumberMovers] OF UDINT;
	nInitPositionMoverTable			: ARRAY [1..gc_nMaxNumberMovers] OF UDINT;
	nMoverRecoveryPosition			: ARRAY [1..gc_nMaxNumberMovers] OF UDINT;
	nJoinTrack						: ARRAY [1..gc_nMaxNumberMovers] OF UDINT;	
	
	fRotationMoverPosition			: ARRAY [1..gc_nMaxNumberMovers,1..2] OF LREAL;
	nMoverToRotationPosition		: UDINT;
	nRotationPositionToMoveTo		: UDINT;
	nMoverBackToInitPosition		: UDINT;

	sInfoText						: STRING;
	targetPos            	 		: PositionXYC;
    currentPos			     		: PositionXYC;
	nCmdReturnError					: UDINT;
	
	
//-----------------first Track run

	fTrackLengthTrack1  	: LREAL;
	fTrackLengthTrack2  	: LREAL;	
	fTrackLengthTrack3  	: LREAL;	
	
	bInitRunFlag			: BOOL;
	bInitRunDone			: BOOL;
	bOneMoverMoving			: BOOL;
	bAllMoversStandingStill	: BOOL;
	bMoversQueuing			: BOOL;
	
	TimerWaitForMovement	: TON;	
	
	
	nState 					: INT;	
	nStateInit				: INT;
	
	
	fbInitList				: FB_List;

	fPositionOnTrack			: LREAL;
	nStationIndex				: UINT;
	nNextStationTrackIndex 		: UINT;
	fNextStationWaitingPosition	: LREAL;
	nTrackIndex					: UDINT;
	nNextStationIndex			: UDINT;
	nListIdentifier				: UDINT;
	bFirstMoverIn				: BOOL;
	ClearTrig					: R_TRIG;
	fMoverPosition				: LREAL;
	fMoverVelocity				: LREAL;
	fMoverAcceleration			: LREAL;
	fMoverJerk					: LREAL;
	strInfo						: STRING;
	
	fMoverSpace					: LREAL;
	fWaitingPositionStation01	: LREAL;
	fWaitingPositionStation02	: LREAL;	
	fWaitingPositionStation03	: LREAL;	
	fWaitingPositionStation04	: LREAL;	
	fWaitingPositionStation05b	: LREAL;	
	fWaitingPositionStation05c	: LREAL;
	
	stMoveParameters 	: ST_MoveOnTrackOptions; 
	strInfoHistory		: ARRAY[0..10] OF STRING;
	
	nResult				: DINT;
	sMessage			: STRING;
	
	
	stJoinTrackOptions		: ST_JoinTrackOptions;
	stMoveOptionsCurve		: ST_MoveCOptions;	

	
	
	nMoverToTurnBack				: UDINT;
	fRecoveryRotTarget				: LREAL;
	fRecoveryRotVel					: LREAL :=  360.0;
	fRecoveryRotAcc					: LREAL := 1800.0;
	fRecoveryRotJerk				: LREAL := 9000.0;
	stRotationOptions				: ST_MoveCOptions;
	
	
	LeavOptions	: ST_LeaveTrackOptions;
	
END_VAR


VAR_INST
	nMoverToTurn					: UDINT;

	fbMoverTarget		: FB_MoverTarget;
	nErrorCode			: DINT;
	bError				: BOOL;
	sInfoMessage		: STRING;

	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bReset THEN
	nStateMoverRecovery := 0;
	MoverRecovery := TRUE;
END_IF



CASE nStateMoverRecovery OF

	0:	// Starting mover recovery
		nStateMoverRecovery := 50;
			
	(***************************************************************************************)
	(* Mover Recovery Part1: Checking for unfinished rotation                              *)
	(***************************************************************************************)     			
		
	50:		// Turn rotation angle to closets quarter-angle 
			ipVisuMessage.SetInfoMessage('Clearing rotation', 'Recovery', nStateMoverRecovery);

			nMoverToTurn := 0;
			nStateMoverRecovery := nStateMoverRecovery +1;
			
	51:  	nMoverToTurn := nMoverToTurn +1;
			IF nMoverToTurn > g_nMoverCount THEN
				nStateMoverRecovery := nStateMoverRecovery +3;
			ELSE
				IF ipMoverApplication[nMoverToTurn].std.P_IsPresent THEN

					fRecoveryRotTarget 				  := ipMoverApplication[nMoverToTurn].std.P_ClosestQuaterAngle;	
					stRotationOptions.additionalTurns := 0;
					stRotationOptions.direction		  := Tc3_Mc3PlanarMotion.MC_direction.mcDirectionNonModulo;	
					
					ipMoverApplication[nMoverToTurn].std.MoveC('Recovery - unfinished rotation', fRecoveryRotTarget, fRecoveryRotVel, fRecoveryRotAcc, fRecoveryRotAcc, fRecoveryRotJerk, stRotationOptions);
					nStateMoverRecovery := nStateMoverRecovery +1;				
				END_IF	
			END_IF

	52:		IF ipMoverApplication[nMoverToTurn].std.P_MoveC.Done THEN
				nStateMoverRecovery := nStateMoverRecovery -1;	
			ELSIF ipMoverApplication[nMoverToTurn].std.P_MoveC.Error THEN
				nStateMoverRecovery := nStateMoverRecovery +1;	
			END_IF
 
	53:		// Check error ID and react accordingly
			nErrorID := ipMoverApplication[nMoverToTurn].std.P_MoveC.ErrorID;	
			
			// In case rotation is not possible due to collision with another mover proceed without rotation correction.
			IF nErrorID = 33158 THEN
				nStateMoverRecovery := nStateMoverRecovery -2;	
			END_IF
						
	54:		nStateMoverRecovery := 100;		
			
			
	(*******************************************************************************************)
	(* Mover Recovery Part2: Separating all movers and move each of them to a corner position. *)
	(*******************************************************************************************)    			
		
	100: 
		ipVisuMessage.SetInfoMessage('Separating all movers', 'Recovery', nStateMoverRecovery);
		IF fbMoverTarget.Clear() THEN
			nStateMoverRecovery := nStateMoverRecovery +10;
		END_IF
	
	110:
		bError := FALSE;
		FOR idx:=1 TO g_nMoverCount DO
			IF ipMoverApplication[idx].std.P_IsPresent THEN
				fbMoverTarget.AddMover(ipMoverApplication[idx]);
				IF fbMoverTarget.P_ErrorWarningCode < 0 THEN
					bError := TRUE;
				END_IF
			END_IF
		END_FOR
		
		IF bError THEN
			sInfoMessage := fbMoverTarget.P_Info;
		ELSE
			nStateMoverRecovery := nStateMoverRecovery +10;
		END_IF
			
	120:
		fbMoverTarget.AddPosition(120.0, 120.0);
		fbMoverTarget.AddPosition(120.0, 600.0);
		fbMoverTarget.AddPosition(840.0, 600.0);
		fbMoverTarget.AddPosition(840.0, 120.0);
		
		fbMoverTarget.SetDynamics(250.0, 1000.0, 10000.0);
		
		IF fbMoverTarget.P_ErrorWarningCode < 0 THEN
			sInfoMessage := fbMoverTarget.P_Info;
		ELSE
			nStateMoverRecovery := nStateMoverRecovery +10;
		END_IF
		

	130:
		  sMessage := fbMoverTarget.P_Info;
		nErrorCode := fbMoverTarget.P_ErrorWarningCode;	

		IF fbMoverTarget.MoversToTarget() THEN
			nStateMoverRecovery := 300;
		END_IF
					
	
	(***************************************************************************************)
	(* Mover Recovery Part3: All movers join the outer-track							   *)
	(***************************************************************************************)  	
					
			
	300:	// All movers go on track
			ipVisuMessage.SetInfoMessage('All movers join track', 'Recovery', nStateMoverRecovery);
	
			FOR nForCounter := 1 TO g_nMoverCount DO
				IF ipMoverApplication[nForCounter].std.P_SetPosition.x > 480.0 THEN
					nJoinTrack[nForCounter] := 3;	
				ELSE
					nJoinTrack[nForCounter] := 1;	
				END_IF
			END_FOR
			nStateMoverRecovery := nStateMoverRecovery +1;	
				
	301:	IF nMoverToJoinTrack < g_nMoverCount THEN
				nMoverToJoinTrack := nMoverToJoinTrack +1;
				nStateMoverRecovery := nStateMoverRecovery +1;
			ELSE
				nMoverToJoinTrack := 0;
				nStateMoverRecovery := nStateMoverRecovery + 2; 
			END_IF
				
	302:	stJoinTrackOptions.useOrientation := FALSE;
	
			sInfoText := 'Recovery, join TrackID: ';
			sInfoText := CONCAT(sInfoText, UDINT_TO_STRING(nJoinTrack[nMoverToJoinTrack]));
			
			IF ipMoverApplication[nMoverToJoinTrack].std.JoinTrack( sInfoText,
																	ipTrack[nJoinTrack[nMoverToJoinTrack]].std,
																    fVeloRec,
																	fAccelRec,
																	fJerkRec,
																	stJoinTrackOptions )
			THEN
				ipMoverApplication[nMoverToJoinTrack].P_TrackId := nJoinTrack[nMoverToJoinTrack];
				nStateMoverRecovery := nStateMoverRecovery -1;
			END_IF
			
				
			
			
	303:	bDone := TRUE;
			FOR nForCounter := 1 TO g_nMoverCount DO
				bDone := bDone AND ipMoverApplication[nForCounter].std.P_JoinTrack.Done;
			END_FOR
			
			IF bDone THEN
				nStateMoverRecovery := nStateMoverRecovery + 7;
			END_IF
		
	310:  // Wait for all movers on-track
			bDone := TRUE;
			FOR nForCounter := 1 TO g_nMoverCount DO
				bDone := bDone AND ipMoverApplication[nForCounter].std.P_JoinTrack.Done;
			END_FOR
			IF bDone THEN
				nStateMoverRecovery := 400;
			END_IF
	
				
	(***************************************************************************************)
	(* Mover Recovery Part4: Adding all movers to the Initialization-List and sort them    *)
	(*                       ascending.                              				       *)
	(***************************************************************************************)  			
				
	400:	ipVisuMessage.SetInfoMessage('Sorting all movers', 'Recovery', nStateMoverRecovery);
			IF fbInitList.ClearList() THEN
				nStateMoverRecovery := nStateMoverRecovery + 1;
			END_IF
			
	401:	IF fbInitList.ClearTrackOrder() THEN
				nStateMoverRecovery := nStateMoverRecovery + 9;
			END_IF
	
			
	410:	// Adding all movers to the Initialization-List
			FOR nForCounter := 1 TO g_nMoverCount DO
				fbInitList.AddMover(ipMoverApplication[nForCounter].std);
			END_FOR				
			nStateMoverRecovery := nStateMoverRecovery + 10;
			
			
	420: 	// Adding Track-Order to the Initialization-List for Sorting-Order
			IF fbInitList.AddTrack(ipTrack[1].std) > 0 THEN
				nStateMoverRecovery := nStateMoverRecovery + 1;
			ELSE
				 nResult := fbInitList.P_nResult;
				sMessage := fbInitList.P_sMessage;	
			END_IF
			
	421: 	IF fbInitList.AddTrack(ipTrack[3].std) > 0 THEN
				nStateMoverRecovery := nStateMoverRecovery + 1;
			ELSE
				 nResult := fbInitList.P_nResult;
				sMessage := fbInitList.P_sMessage;	
			END_IF			
						
 	422:	nStateMoverRecovery := 450;
				
	450:	// Sorting all movers 
			fbInitList.P_SortingDirection := eSortingDirection.ascending;
			fbInitList.P_SortingOrigin := 0.0;
	
			 nResult := fbInitList.SortList();
			sMessage := fbInitList.P_sMessage;
			
			IF nResult > 0 THEN
				// Sorting succesful - will return the number of movers sorted e.g. 4
				nStateMoverRecovery:= nStateMoverRecovery + 10;
			ELSIF nResult = 0 THEN
				;// Sorting 
			ELSIF nResult < 0 THEN
				// sorting Error - Check error code and error message
				nStateMoverRecovery:= nStateMoverRecovery +1;
			END_IF
			
	451:	// Check error message and act accordingly		
			 nResult := fbInitList.P_nResult;
			sMessage := fbInitList.P_sMessage;				
	
			
	460:	nStateMoverRecovery:= 500;			
	

	
	(***************************************************************************************)
	(* Mover Recovery Part5: Initialization-Run                                            *)
	(*						 - Sending/Adding each mover to its next closest station       *)
	(*						 - From there on each station takes care of the init-run       *)
	(* 						 - Movers will queu in in front of station 01 				   *)
	(***************************************************************************************)  

	500: // Init all variables 
		ipVisuMessage.SetInfoMessage('Mover init-run', 'Recovery', nStateMoverRecovery);
	
					bOneMoverMoving := FALSE;
			bAllMoversStandingStill := FALSE;
					   bInitRunDone := FALSE;
	
				   nStateMoverRecovery := nStateMoverRecovery + 10;
	
	510: // Check for next Mover
		IF fbInitList.P_FirstInList <> 0 THEN
				 nMoverIndex := fbInitList.P_FirstInList.P_Id;
				 nTrackIndex := ipMoverApplication[nMoverIndex].P_TrackId;
			fPositionOnTrack := ipMoverApplication[nMoverIndex].std.P_SetOnTrack.SetPos;
			
			      bFirstMoverIn := TRUE;
			nStateMoverRecovery := nStateMoverRecovery + 10;
		ELSE
			IF bFirstMoverIn THEN
				nStateMoverRecovery := 600;
			ELSE
				// Init-Run completed
				bInitRunFlag := FALSE;
				nStateMoverRecovery := 1000;	
			END_IF
		END_IF
			
		
	520: // Figuring out the next station the mover has to travel to:
		fMoverSpace := 155.0 + 5.0;
	
		fWaitingPositionStation01	:= ipTrack[1].P_TrackLength/2.0 - fMoverSpace;	
		fWaitingPositionStation02	:= ipTrack[2].P_TrackLength/2.0 - fMoverSpace;	
		fWaitingPositionStation03	:= ipTrack[3].P_TrackLength/2.0 - fMoverSpace;
		fWaitingPositionStation04	:= ipTrack[1].P_TrackLength - fMoverSpace;	
		fWaitingPositionStation05b	:= ipTrack[3].P_TrackLength - fMoverSpace;	
		fWaitingPositionStation05c	:= ipTrack[2].P_TrackLength - fMoverSpace;	
	
		nListIdentifier := 0;
		CASE nTrackIndex OF		
		1:	// Mover on Track01 / Station01
			IF fPositionOnTrack <= fWaitingPositionStation01 THEN
				nNextStationIndex := 1;
				  nListIdentifier := 11;
			ELSE
				nNextStationIndex := 4;
				  nListIdentifier := 14;
			END_IF	
	
		2:	// Mover on Track02 / Station02
			IF fPositionOnTrack <= fWaitingPositionStation02 THEN
				nNextStationIndex := 2;
				  nListIdentifier := 22;
			ELSE
				nNextStationIndex := 5;
				  nListIdentifier := 25;
			END_IF			
		
		3:	// Mover on Track03 / Station 03
			IF fPositionOnTrack <= fWaitingPositionStation03 THEN
				nNextStationIndex := 3;
				  nListIdentifier := 33;
			ELSE
				nNextStationIndex := 5;
				  nListIdentifier := 35;
			END_IF			
		END_CASE
		
		nStateMoverRecovery := nStateMoverRecovery + 10;
			
			
	530: // Calculating the position the mover has to move to next:
		nNextStationTrackIndex := 0;
		
		CASE nNextStationIndex OF
			1:	nNextStationTrackIndex      := 1;
				fNextStationWaitingPosition	:= fWaitingPositionStation01;	
			
			2:	nNextStationTrackIndex      := 2;
				fNextStationWaitingPosition	:= fWaitingPositionStation02;			
			
			3:	nNextStationTrackIndex      := 3;
				fNextStationWaitingPosition	:= fWaitingPositionStation01;			
			
			4:	nNextStationTrackIndex      := 1;
				fNextStationWaitingPosition	:= fWaitingPositionStation04;				
				
			5:	IF nTrackIndex = 2 THEN
					nNextStationTrackIndex := 2;
					fNextStationWaitingPosition	:= fWaitingPositionStation05c;	
				ELSIF nTrackIndex = 3 THEN
					nNextStationTrackIndex := 3;
					fNextStationWaitingPosition	:= fWaitingPositionStation05b;	
				END_IF									
		END_CASE
			
		IF nNextStationTrackIndex > 0 THEN
			nStateMoverRecovery := nStateMoverRecovery + 10;
		END_IF
	
	
	540: 	// Send mover to the next station
			fMoverPosition     := fNextStationWaitingPosition;
			fMoverVelocity     :=    300.0;
			fMoverAcceleration :=  1_000.0;
			fMoverJerk         := 10_000.0;	
	
			stMoveParameters.direction := Tc3_Mc3PlanarMotion.MC_DIRECTION.mcDirectionPositive;
			stMoveParameters.gap       := 240.0;
			
			strInfo := 'Recovery: ';
			strInfo := CONCAT(strInfo, ' Mover: ');
			strInfo := CONCAT(strInfo, UDINT_TO_STRING(nMoverIndex));
			strInfo := CONCAT(strInfo, ' move to Station:' );
			strInfo := CONCAT(strInfo, UDINT_TO_STRING(nNextStationIndex));
			
		
			IF NOT ipMoverApplication[nMoverIndex].std.P_MoveOnTrack.Busy THEN
	
				FOR idx:=10 TO 1 BY -1 DO 
					strInfoHistory[idx] := strInfoHistory[idx-1];
				END_FOR
				strInfoHistory[0] := strInfo;		
			
				ipMoverApplication[nMoverIndex].std.MoveOnTrack( strInfo,
																 ipTrack[nNextStationTrackIndex].std,
																 fMoverPosition,
																 fMoverVelocity,
																 fMoverAcceleration,
																 fMoverJerk,
																 stMoveParameters.gap,
																 stMoveParameters.direction);
				nStateMoverRecovery := nStateMoverRecovery +1;
				
				
				ipMoverApplication[nMoverIndex].P_ProductData.bInitRun            := TRUE;
				ipMoverApplication[nMoverIndex].P_ProductData.nDestinationProcess := 0;
			END_IF	
			
	541: 
		IF ipMoverApplication[nMoverIndex].std.P_MoveOnTrack.Active THEN
			nStateMoverRecovery := nStateMoverRecovery + 9;
		END_IF
			
	 
	550: // Mover to the list of the next station
		CASE nListIdentifier OF
		11:	ipStation[1].P_List_Station.AddMover(fbInitList.RemoveFirstInList());
		14: ipStation[4].P_List_Switch_Input_A.AddMover(fbInitList.RemoveFirstInList());
		
		22: ipStation[2].P_List_Station.AddMover(fbInitList.RemoveFirstInList());
		25:	ipStation[5].P_List_Switch_Input_C.AddMover(fbInitList.RemoveFirstInList());
		
		33: ipStation[3].P_List_Station.AddMover(fbInitList.RemoveFirstInList());
		35: ipStation[5].P_List_Switch_Input_B.AddMover(fbInitList.RemoveFirstInList());
		END_CASE
	
		IF nListIdentifier > 0 THEN
			nStateMoverRecovery := 510;	
		END_IF
		

	600: // Set all stations into "Init-Run" Mode	
		FOR idx:=1 TO gc_NumberStations DO
			ipStation[idx].P_eProcessMode := E_ProcessMode.InitRun;
		END_FOR	
		nStateMoverRecovery := nStateMoverRecovery + 10;	
		
		
	610: // Wait till at least one mover started moving, or timeout if no movement at all.	
		bOneMoverMoving := FALSE;
		FOR idx:=1 TO g_nMoverCount DO	
			IF ABS(ipMoverApplication[idx].std.P_SetVelocity.x) > 0.1
			OR ABS(ipMoverApplication[idx].std.P_SetVelocity.y) > 0.1
			THEN
				bOneMoverMoving := TRUE;
			END_IF
		END_FOR		
	
		TimerWaitForMovement(IN:=TRUE, PT:=T#2S);
		
		IF bOneMoverMoving 
		OR TimerWaitForMovement.Q 
		THEN
			TimerWaitForMovement(IN:=FALSE);
			nStateMoverRecovery := nStateMoverRecovery + 10;			
		END_IF
		
	
	620: // Wait till all movers are standing still	
		bAllMoversStandingStill := TRUE;
		FOR idx:=1 TO g_nMoverCount DO			
			IF ipMoverApplication[idx].std.P_IsMovingXY THEN
				bAllMoversStandingStill := FALSE;
			END_IF
		END_FOR
		
		IF bAllMoversStandingStill THEN
			nStateMoverRecovery := nStateMoverRecovery + 10;				
		END_IF
		
		
	630: // Init-Run done
		FOR idx:=1 TO gc_NumberStations DO
			ipStation[idx].P_eProcessMode := E_ProcessMode.None;
		END_FOR		

			   bInitRunDone := TRUE;
		nStateMoverRecovery := 1000;		
			
	
	1000:// Mover recovery done
		ipVisuMessage.SetInfoMessage('Mover recovery done', 'Recovery', nStateMoverRecovery);
	
			   MoverRecovery := TRUE;
		 nStateMoverRecovery := 0;	
			

END_CASE


ipVisuMessage.StateUpdate(nStateMoverRecovery, 'Recovery');




	

	

		]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_AbortingSequence" Id="{1589822b-155c-45bb-b032-059d0c6c0241}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY P_AbortingSequence : DINT]]></Declaration>
      <Get Name="Get" Id="{97441fda-522f-480c-8a56-74bf795f92c9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_AbortingSequence := nAbortingSequence;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Alarm" Id="{a987617e-cc1a-40df-beb0-3ffd40991783}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY P_Alarm : ST_VisuMessage]]></Declaration>
      <Get Name="Get" Id="{3ac26912-c6c4-4f0f-98f9-a41adcc915af}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
