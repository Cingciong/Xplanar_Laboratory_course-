    <Method Name="Prepare" Id="{dbac9a22-f245-438d-9863-d6f49428be15}" FolderPath="StateMachine\">
      <Declaration><![CDATA[METHOD Prepare : BOOL


VAR_INST
	Test : LREAL;	

	bAllMoversDone				: BOOL; 	
	
	nStationToInit				: UINT;
	

	nMoversFound				: UDINT;
	
	sTextTemp					: STRING;
	

	
	nTestCounter				: UDINT;
	
	
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nErrorID := 0;

CASE nPrepareSequence OF 
	

	0:	// Enter
		nPrepareSequence := 10;	

	
	(***************************************************************************************)
	(* Starting Part 1: Getting everything ready...                                        *)
	(***************************************************************************************) 		
			
	10: // EnableGroup
		IF ipMotionSystem.EnableGroup() THEN
			ipVisuMessage.SetInfoMessage('ENABLE Group', 'Prepare', nPrepareSequence);
			nPrepareSequence := nPrepareSequence + 1;
		END_IF
		
	11: IF ipMotionSystem.P_EnableGroup.Done THEN
			nPrepareSequence := nPrepareSequence +9;
		ELSIF ipMotionSystem.P_EnableGroup.Error THEN
			nPrepareSequence := nPrepareSequence + 1;
		END_IF	
			
	12:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_EnableGroup.ErrorID;
		ipVisuMessage.SetErrorMessage('ENABLE Group failed', 'Prepare', nPrepareSequence, nErrorID);		
		
		
	20: // Adding Environment to Group
		IF ipMotionSystem.AddEnvironmentToGroup() THEN
			ipVisuMessage.SetInfoMessage('Add Group to Environment', 'Prepare', nPrepareSequence);
			nPrepareSequence := nPrepareSequence +1;
		END_IF	
		
	21: IF ipMotionSystem.P_AddEnviromentToGroup.Done THEN
			nPrepareSequence := nPrepareSequence +9;
		ELSIF ipMotionSystem.P_AddEnviromentToGroup.Error THEN
			nPrepareSequence := nPrepareSequence +1;		
		END_IF	
		
	22:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_AddEnviromentToGroup.ErrorID;
		ipVisuMessage.SetErrorMessage('Add Group to Environment failed', 'Prepare', nPrepareSequence, nErrorID);			
				
				
	30: // Enable all tracks
		IF ipMotionSystem.EnableTracks() THEN
			ipVisuMessage.SetInfoMessage('ENABLE Tracks', 'Prepare', nPrepareSequence);
			nPrepareSequence := nPrepareSequence +1;
		END_IF
		
	31:	
		IF ipMotionSystem.P_EnableTracks.Done THEN
			nPrepareSequence := nPrepareSequence +9;
		ELSIF ipMotionSystem.P_EnableTracks.Error THEN
			nPrepareSequence := nPrepareSequence +1;		
		END_IF
		
	32:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_EnableTracks.ErrorID;
		ipVisuMessage.SetErrorMessage('ENABLE Tracks failed', 'Prepare', nPrepareSequence, nErrorID);				
		
			
	40: // Adding all tracks to the group
		IF ipMotionSystem.AddTracksToGroup() THEN
			ipVisuMessage.SetInfoMessage('Add tracks to Group', 'Prepare', nPrepareSequence);
			nPrepareSequence := nPrepareSequence +1;
		END_IF
	
	41: IF ipMotionSystem.P_AddTracksToGroup.Done THEN
			nPrepareSequence := nPrepareSequence +9;
		ELSIF ipMotionSystem.P_AddTracksToGroup.Error THEN
			nPrepareSequence := nPrepareSequence +1;
		END_IF
		
	42:	// Check error ID and react accordingly120
		nErrorID := ipMotionSystem.P_AddTracksToGroup.ErrorID;
		ipVisuMessage.SetErrorMessage('Add tracks to Group failed', 'Prepare', nPrepareSequence, nErrorID);				

	
	50: // Init all stations
		nStationToInit := 0;
		nPrepareSequence := nPrepareSequence +1;

	51:	nStationToInit := nStationToInit +1;
		IF nStationToInit <= gc_NumberStations THEN
			ipVisuMessage.SetInfoMessage(CONCAT('Init Station:' ,UINT_TO_STRING(nStationToInit)), 'Prepare', nPrepareSequence);
			nPrepareSequence := nPrepareSequence +1;
		ELSE
			nPrepareSequence := nPrepareSequence +9;
		END_IF	
				
	52: IF ipStation[nStationToInit].Init() THEN
			nPrepareSequence := nPrepareSequence -1;
		END_IF

		
	60:	nPrepareSequence := 100;
	
	
	
	100: // Prepare all movers
		IF MoverPreparation(bReset:=TRUE) THEN
			nPrepareSequence := nPrepareSequence + 1;
		END_IF
		
	101:
		IF MoverPreparation(bReset:=FALSE) THEN
			nPrepareSequence := nPrepareSequence + 9;
		END_IF	
		
		
		
	110: nPrepareSequence := 160;
		
	
	160:// Enable all movers
		IF ipMotionSystem.EnableMovers() THEN
			ipVisuMessage.SetInfoMessage('ENABLE all movers', 'Prepare', nPrepareSequence);
			nPrepareSequence := nPrepareSequence + 1;
		END_IF
	
	161: 
		IF ipMotionSystem.P_EnableMovers.Done THEN
			nPrepareSequence := nPrepareSequence +9;
		ELSIF ipMotionSystem.P_EnableMovers.Error THEN

			nPrepareSequence := nPrepareSequence + 1;
		END_IF	
			
	162:// Error = Not able to enable movers e.g. mover was not able to reach it's flight hight due to high payload 
		nErrorID := ipMotionSystem.P_EnableMovers.ErrorID;	
		ipVisuMessage.SetErrorMessage('ENABLE all movers failed', 'Prepare', nPrepareSequence, nErrorID);	
	

		
	
    170: // Adding movers to the group
		IF ipMotionSystem.AddMoversToGroup() THEN
			ipVisuMessage.SetInfoMessage('Add movers to Group', 'Prepare', nPrepareSequence);
			nPrepareSequence := nPrepareSequence + 1;
		END_IF
	
    171: IF ipMotionSystem.P_AddMoversToGroup.Done THEN
			nPrepareSequence := nPrepareSequence +9;
		ELSIF ipMotionSystem.P_AddMoversToGroup.Error THEN
			nPrepareSequence := nPrepareSequence + 1;
		END_IF	
	
    172:// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_AddMoversToGroup.ErrorID;
		ipVisuMessage.SetErrorMessage('Add movers to Group failed', 'Prepare', nPrepareSequence, nErrorID);	
	
	
	180: nPrepareSequence := 200;			
				

	(***************************************************************************************)
	(* Starting Part 3: Organize all movers to get ready for the machine process           *)
	(***************************************************************************************) 		
			
	200:  // Mover Recovery/Sorting
		IF MoverRecovery(bReset:=TRUE) THEN;
			nPrepareSequence := nPrepareSequence +1;	
		END_IF	
	
	201:
		IF MoverRecovery(bReset:=FALSE) THEN
			nPrepareSequence := nPrepareSequence +9;		
		END_IF
	
			
	210:  // Prepare sequence done
		ipVisuMessage.SetInfoMessage('PREPARE finished', 'Prepare', 0);
					 Prepare := TRUE;			 
			nPrepareSequence := 0; 
			
		
END_CASE


ipVisuMessage.StateUpdate(nPrepareSequence, 'Prepare');
	






















]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{d4ed3da2-5d89-417f-9ada-092f6348d790}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[	
	// Resetting all necesarry internal data 
	bMoverError := FALSE;



	Reset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Resetting" Id="{694859be-68a2-4e34-b4af-c62ce9ab73dd}" FolderPath="StateMachine\">
      <Declaration><![CDATA[METHOD Resetting : BOOL
VAR_INPUT
END_VAR




VAR_INST
	
	nTrackToEnable		: UDINT;
	stProductDataClear 	: ST_ProductData;
	
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[nErrorID := 0;

CASE nResettingSequence OF 
	
	0: // Enter 
		nResettingSequence := 10;
		
		
		
	10: // Reset all movers
		IF ipMotionSystem.ResetMovers() THEN
			ipVisuMessage.SetInfoMessage('RESET all movers', 'Resetting', nResettingSequence);
			nResettingSequence := nResettingSequence +1;			
		END_IF
		
	11: IF ipMotionSystem.P_ResetMovers.Done THEN
			nResettingSequence := nResettingSequence +9;
		ELSIF ipMotionSystem.P_ResetMovers.Error THEN
			nResettingSequence := nResettingSequence +1;	
		END_IF

	12:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_EnableMovers.ErrorID;
		ipVisuMessage.SetErrorMessage('RESET movers failed', 'Resetting', nResettingSequence, nErrorID);					
		
		
		
	20:	// Reset all tracks
		IF ipMotionSystem.ResetTracks() THEN
			ipVisuMessage.SetInfoMessage('RESET all tracks', 'Resetting', nResettingSequence);
			nResettingSequence := nResettingSequence +1;
		END_IF
		
	21: IF ipMotionSystem.P_ResetTracks.Done THEN
			nResettingSequence := nResettingSequence +9;
	 	ELSIF ipMotionSystem.P_ResetTracks.Error THEN
			nResettingSequence := nResettingSequence +1;	
		END_IF
	
	22:	// Check error ID and react accordingly
		nErrorID := ipMotionSystem.P_EnableMovers.ErrorID;
		ipVisuMessage.SetErrorMessage('RESET tracks failed', 'Resetting', nResettingSequence, nErrorID);			
		
	
		
	30:	// Reset MotionSystemApplication
		IF ipMotionSystemApplication.Reset() THEN
			ipVisuMessage.SetInfoMessage('RESET MotionSystemApplication', 'Resetting', nResettingSequence);
			nResettingSequence := nResettingSequence +10;
		END_IF
	
				
	40:  // Cleaning all process data
		FOR idx:=1 TO g_nMoverCount DO
			ipMoverApplication[idx].P_ProductData := stProductDataClear;
		END_FOR
		nResettingSequence := 100;
		
	
	100: // Reset done
		ipVisuMessage.SetInfoMessage('RESET finished', 'Resetting', 0);
	
		nResettingSequence := 0; 
		         Resetting := TRUE;

END_CASE



ipVisuMessage.StateUpdate(nResettingSequence, 'Resetting');



























]]></ST>
      </Implementation>
    </Method>
    <Method Name="Startup" Id="{1e53eaa1-63e7-4d66-8826-754b8d6a2263}" FolderPath="StateMachine\">
      <Declaration><![CDATA[METHOD Startup : BOOL
VAR
	aMoverDetectionSetup	: ARRAY[1..3] OF ST_TcIoMoverDetectionSetup;
END_VAR

VAR_INST
	
	// Tracks
	nTrackToInit			: UDINT;
	nTrackToGroup			: UDINT;
	sErrorInfo				: STRING;
	
	stHaltDynamics			: ST_HaltDynamics;
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

CASE nStartupSequence OF 
	
	0: // Enter
		IF ipVisuMessage <> 0 THEN
			nStartupSequence := nStartupSequence +1;
		END_IF

 
	1: // Wait for initialization
		IF ipMotionSystem.P_SystemInitialized THEN
			ipVisuMessage.SetInfoMessage('MotionSystem initialized', 'Startup', nStartupSequence);	
			nStartupSequence := 10;
		ELSE
			ipVisuMessage.SetInfoMessage('Waiting for initialization of MotionSystem', 'Startup', nStartupSequence);	
		END_IF
	
	
	10: // Initialization of all tracks	
		    nTrackToInit := 0;
		nStartupSequence := nStartupSequence +1;
	
	11: // Track number count
		IF nTrackToInit < gc_NumberTracks THEN
			nTrackToInit := nTrackToInit + 1;
			nStartupSequence := nStartupSequence +1;
					
			sTextTemp := 'Initializing Track: ';
			sTextTemp := CONCAT(sTextTemp, UDINT_TO_STRING(nTrackToInit));			
			ipVisuMessage.SetInfoMessage(sTextTemp, 'Startup', nStartupSequence);
		ELSE
			    nTrackToInit := 0;
			nStartupSequence := 20;
		END_IF
				
	12:	// Clear track data
		IF ipTrack[nTrackToInit].Clear() THEN
			nStartupSequence := nStartupSequence +1;
		END_IF
		
	13: // Build the track
		IF ipTrack[nTrackToInit].Initialize(nTrackToInit) THEN	
			nStartupSequence := 11;
		ELSE
			IF ipTrack[nTrackToInit].P_Error THEN
				nStartupSequence := nStartupSequence +1;
			END_IF
		END_IF
		
	14:	// In case of error react accordingly
		sErrorInfo := ipTrack[nTrackToInit].P_ErrorInfo;
				
		sTextTemp := CONCAT(sErrorInfo, UDINT_TO_STRING(nTrackToInit));			
		ipVisuMessage.SetErrorMessage(sTextTemp, 'Startup', nStartupSequence, 0);
	
	
	20: // Setting halt-dynamics for all movers
		stHaltDynamics.Mode := E_HaltDynamicsMode.AxisX_AxisY_CoordinatedOnPath;
	
		stHaltDynamics.PathXY.fVelocity		:=    500.0;
		stHaltDynamics.PathXY.fAcceleration	:=  10000.0;
		stHaltDynamics.PathXY.fDeceleration	:=  10000.0;
		stHaltDynamics.PathXY.fJerk			:= 100000.0;

		stHaltDynamics.AxisX.fVelocity		:=    500.0;
		stHaltDynamics.AxisX.fAcceleration	:=  10000.0;
		stHaltDynamics.AxisX.fDeceleration	:=  10000.0;
		stHaltDynamics.AxisX.fJerk			:= 100000.0;

		stHaltDynamics.AxisY.fVelocity		:=    500.0;
		stHaltDynamics.AxisY.fAcceleration	:=  10000.0;
		stHaltDynamics.AxisY.fDeceleration	:=  10000.0;
		stHaltDynamics.AxisY.fJerk			:= 100000.0;

		stHaltDynamics.AxisZ.fVelocity		:=    500.0;
		stHaltDynamics.AxisZ.fAcceleration	:=  10000.0;
		stHaltDynamics.AxisZ.fDeceleration	:=  10000.0;
		stHaltDynamics.AxisZ.fJerk			:= 100000.0;		
		
		stHaltDynamics.AxisA.fVelocity		:=     10.0;
		stHaltDynamics.AxisA.fAcceleration	:=    100.0;
		stHaltDynamics.AxisA.fDeceleration	:=    100.0;	
		stHaltDynamics.AxisA.fJerk          :=    100.0;		
		
		stHaltDynamics.AxisB.fVelocity		:=     10.0;
		stHaltDynamics.AxisB.fAcceleration	:=    100.0;
		stHaltDynamics.AxisB.fDeceleration	:=    100.0;	
		stHaltDynamics.AxisB.fJerk          :=    100.0;			
		
		stHaltDynamics.AxisC.fVelocity		:=     36.0;
		stHaltDynamics.AxisC.fAcceleration	:=    360.0;
		stHaltDynamics.AxisC.fDeceleration	:=    360.0;	
		stHaltDynamics.AxisC.fJerk          :=    360.0;
		
		FOR idx:=1 TO g_nMoverCount DO
			ipMoverApplication[idx].std.P_HaltDynamics := stHaltDynamics;
		END_FOR
		
		nStartupSequence := 100;


	100: // Start-Up Done!
		ipVisuMessage.SetInfoMessage('START-UP finished', 'Startup', 0);				
		Startup := TRUE;
		
END_CASE


ipVisuMessage.StateUpdate(nStartupSequence, 'Startup');








]]></ST>
      </Implementation>
    </Method>
