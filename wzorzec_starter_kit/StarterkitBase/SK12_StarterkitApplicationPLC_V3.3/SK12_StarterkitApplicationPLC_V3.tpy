perty><Name>property</Name></Property><Property><Name>hide</Name></Property><Property><Name>obsolete</Name><Value>Obsolete: Please use P_SortingOrigin instead</Value></Property></Properties></Method><Method><Name>__setP_SortingDirection</Name><Parameter><Name>P_SortingDirection</Name><Type Namespace="Tc3_XPlanarStandard">eSortingDirection</Type><BitSize>16</BitSize></Parameter><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>__setP_SortingOrigin</Name><Parameter><Name>P_SortingOrigin</Name><Type>LREAL</Type><BitSize>64</BitSize></Parameter><Properties><Property><Name>property</Name></Property></Properties></Method><FbInfo /><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name Decoration="30000390">Tc3_Mc3PlanarMotion.MC_DIRECTION</Name><Type>UINT</Type><Comment><![CDATA[ Indicates the movement direction of the Planar Mover on a Planar Track. ]]></Comment><BitSize>16</BitSize><EnumInfo><Text>mcDirectionNonModulo</Text><Enum>0</Enum><Comment><![CDATA[ The Planar Mover moves to the absolute value of the target position. Depending on the current position, this may induce forward or backward movement. On looped tracks, multiple passes are possible. ]]></Comment></EnumInfo><EnumInfo><Text>mcDirectionPositive</Text><Enum>1</Enum><Comment><![CDATA[ The Planar Mover moves to the target position in a forward direction. No backward movement is allowed. ]]></Comment></EnumInfo><EnumInfo><Text>mcDirectionShortestWay</Text><Enum>2</Enum><Comment><![CDATA[ The Planar Mover takes the shortest way to the target position. May induce forward or backward movement. ]]></Comment></EnumInfo><EnumInfo><Text>mcDirectionNegative</Text><Enum>3</Enum><Comment><![CDATA[ The Planar Mover moves to the target position in a backward direction. No forward movement is allowed. ]]></Comment></EnumInfo><Properties><Property><Name>qualified_only</Name></Property><Property><Name>to_string</Name></Property><Property><Name>to_string_function</Name><Value>__TO_STRING__2896</Value></Property><Property><Name>to_wstring_function</Name><Value>__TO_WSTRING__2896</Value></Property></Properties></DataType><DataType><Name Decoration="30000390" Namespace="Tc3_Mc3PlanarMotion">Tc3_Mc3PlanarMotion.MC_DIRECTION</Name><Type>MC_DIRECTION</Type><BitSize>16</BitSize></DataType><DataType><Name Decoration="300007D7">MC.MC_DYNAMICS_REDUCTION_MODE</Name><Type>UINT</Type><Comment><![CDATA[ Indicates the way in which dynamics are planned when moving on track. ]]></Comment><BitSize>16</BitSize><EnumInfo><Text>Invalid</Text><Enum>0</Enum><Comment><![CDATA[ Indicates no or invalid information, e.g. no connection or component not yet ready. ]]></Comment></EnumInfo><EnumInfo><Text>None</Text><Enum>1</Enum><Comment><![CDATA[ The Planar Mover interprets the given dynamic limits in a one-dimensional fashion, with respect to the track's arclength. This way, the maximum velocity is aimed at even in curves. ]]></Comment></EnumInfo><EnumInfo><Text>AccelerationLimitedVelocity</Text><Enum>2</Enum><Comment><![CDATA[ The maximal velocity in curves is reduced to not exceed the maximum x,y radial acceleration there. Produces the same behavior as the None mode when on a straight track. ]]></Comment></EnumInfo><Properties><Property><Name>TcTypeSystem</Name></Property><Property><Name>Namespace</Name><Value>MC</Value></Property><Property><Name>qualified_only</Name></Property><Property><Name>to_string</Name></Property><Property><Name>to_string_function</Name><Value>__TO_STRING__3052</Value></Property><Property><Name>to_wstring_function</Name><Value>__TO_WSTRING__3052</Value></Property></Properties></DataType><DataType><Name Decoration="300007D7" Namespace="MC">MC.MC_DYNAMICS_REDUCTION_MODE</Name><Type>MC_DYNAMICS_REDUCTION_MODE</Type><BitSize>16</BitSize></DataType><DataType><Name Decoration="3000061B">MC.MC_GAP_MODE_ON_TRACK</Name><Type>UINT</Type><Comment><![CDATA[ Indicates the way in which gap control is done on track. ]]></Comment><BitSize>16</BitSize><EnumInfo><Text>Invalid</Text><Enum>0</Enum><Comment><![CDATA[ Indicates no or invalid information, e.g. no connection or component not yet ready. ]]></Comment></EnumInfo><EnumInfo><Text>Standard1D</Text><Enum>1</Enum><Comment><![CDATA[ The Planar Mover keeps a distance to its neighbours on track that is at least the sum of gap and stop distance. ]]></Comment></EnumInfo><EnumInfo><Text>Fast1D</Text><Enum>2</Enum><Comment><![CDATA[ The Planar Mover keeps a distance to its neighbours on track that is at least the gap. ]]></Comment></EnumInfo><Properties><Property><Name>TcTypeSystem</Name></Property><Property><Name>Namespace</Name><Value>MC</Value></Property><Property><Name>qualified_only</Name></Property><Property><Name>to_string</Name></Property><Property><Name>to_string_function</Name><Value>__TO_STRING__3055</Value></Property><Property><Name>to_wstring_function</Name><Value>__TO_WSTRING__3055</Value></Property></Properties></DataType><DataType><Name Decoration="3000061B" Namespace="MC">MC.MC_GAP_MODE_ON_TRACK</Name><Type>MC_GAP_MODE_ON_TRACK</Type><BitSize>16</BitSize></DataType><DataType><Name Decoration="1008FF9D">Tc3_Mc3PlanarMotion.ST_MoveOnTrackOptions</Name><Comment><![CDATA[ Options for the "MoveOnTrack" command of the Planar Mover. ]]></Comment><BitSize>256</BitSize><SubItem><Name>gap</Name><Type>LREAL</Type><Comment><![CDATA[ Minimal distance [mm] to next Planar Mover on track. ]]></Comment><BitSize>64</BitSize><BitOffs>0</BitOffs><Default><Value>200</Value></Default></SubItem><SubItem><Name>direction</Name><Type Decoration="30000390">Tc3_Mc3PlanarMotion.MC_DIRECTION</Type><Comment><![CDATA[ Direction in which the target is approached. ]]></Comment><BitSize>16</BitSize><BitOffs>64</BitOffs><Default><EnumText>MC_DIRECTION.mcDirectionNonModulo</EnumText></Default></SubItem><SubItem><Name>additionalTurns</Name><Type>UDINT</Type><Comment><![CDATA[ Addition turns to move in modulo movement (positive or negative). ]]></Comment><BitSize>32</BitSize><BitOffs>96</BitOffs><Default><Value>0</Value></Default></SubItem><SubItem><Name>moduloTolerance</Name><Type>LREAL</Type><Comment><![CDATA[ Tolerance "window" [mm] in modulo movement. ]]></Comment><BitSize>64</BitSize><BitOffs>128</BitOffs><Default><Value>0</Value></Default></SubItem><SubItem><Name>dynamicMode</Name><Type GUID="{51EC8EBA-E260-4EDC-94C0-5ED02ABD2F9A}" Decoration="300007D7">MC.MC_DYNAMICS_REDUCTION_MODE</Type><Comment><![CDATA[ The way in which dynamics are planned on track. ]]></Comment><BitSize>16</BitSize><BitOffs>192</BitOffs><Default><EnumText>MC_DYNAMICS_REDUCTION_MODE.None</EnumText></Default><Properties><Property><Name>Namespace</Name><Value>MC</Value></Property></Properties></SubItem><SubItem><Name>gapMode</Name><Type GUID="{50FEC5F2-C9A2-49A2-AB32-4764BBA0A649}" Decoration="3000061B">MC.MC_GAP_MODE_ON_TRACK</Type><Comment><![CDATA[ The way in which gap control is done with all neighbours on track. ]]></Comment><BitSize>16</BitSize><BitOffs>208</BitOffs><Default><EnumText>MC_GAP_MODE_ON_TRACK.Standard1D</EnumText></Default><Properties><Property><Name>Namespace</Name><Value>MC</Value></Property></Properties></SubItem></DataType><DataType><Name Decoration="10013E1B">Tc3_Mc3PlanarMotion.ST_JoinTrackOptions</Name><Comment><![CDATA[ Options for the "JoinTrack" command of the Planar Mover. ]]></Comment><BitSize>8</BitSize><SubItem><Name>useOrientation</Name><Type>BOOL</Type><Comment><![CDATA[ If true, the target orientation is also reached at the end of the movement. ]]></Comment><BitSize>8</BitSize><BitOffs>0</BitOffs><Default><Bool>true</Bool></Default></SubItem></DataType><DataType><Name Decoration="100362A3">Tc3_Mc3PlanarMotion.ST_MoveCOptions</Name><Comment><![CDATA[ Options for the "MoveC" command of the Planar Mover. ]]></Comment><BitSize>64</BitSize><SubItem><Name>additionalTurns</Name><Type>UDINT</Type><Comment><![CDATA[ Addition turns to move in modulo movement (positive or negative). ]]></Comment><B