			</EventId>
			<EventId>
				<Name Id="#x33170040">E0040_CoordinatedMoverComm_MoverIsActivated</Name>
				<DisplayName TxtId=""><![CDATA[[Event ID: 0x{0,X}] {1} mover(s) are activated, e.g. mover 0x{2,X}. Coordinated mover communication aborted.]]></DisplayName>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="#x33170044">E0044_CoordinatedMoverComm_IdentifiedBtnNotConfigured</Name>
				<DisplayName TxtId=""><![CDATA[[Event ID: 0x{0,X}] Identified BTN '{1}' is not configured.]]></DisplayName>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="#x3317004B">E004B_CoordinatedMoverComm_NoMovers</Name>
				<DisplayName TxtId=""><![CDATA[[Event ID: 0x{0,X}] No movers were found on the system. Coordinated mover communication aborted.]]></DisplayName>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="#x3317004C">E004C_CoordinatedMoverComm_OrientationWrongMoverType</Name>
				<DisplayName TxtId=""><![CDATA[[Event ID: 0x{0,X}] Wrong mover type. Mover 0x{1,X} is a mover type which orientation cannot be determined yet.]]></DisplayName>
				<Severity>Error</Severity>
			</EventId>
			<EventId>
				<Name Id="#x3317004D">E004D_CoordinatedMoverComm_FailedPreparation</Name>
