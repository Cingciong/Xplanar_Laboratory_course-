			</Parameter>
			<Parameter DisableCodeGeneration="true" Group="General">
				<Name>BTN</Name>
				<Comment><![CDATA[8 digit alphanumerical number. Has to be unique for each tile. Has to match with a reference in the corresponding TileCalibration bml file.]]></Comment>
