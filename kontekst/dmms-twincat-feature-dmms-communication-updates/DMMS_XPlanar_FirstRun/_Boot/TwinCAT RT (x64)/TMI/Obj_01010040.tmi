			<Parameter OnlineParameter="true" DisableCodeGeneration="true" ReadOnly="true" Group="General">
				<Name>IsEtherCatOk</Name>
				<Comment><![CDATA[TRUE: EtherCAT is working]]></Comment>
				<BitSize>8</BitSize>
