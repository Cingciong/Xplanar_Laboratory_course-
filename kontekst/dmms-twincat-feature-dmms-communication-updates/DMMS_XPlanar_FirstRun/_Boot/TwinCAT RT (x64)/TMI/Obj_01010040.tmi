			</EventId>
			<EventId>
				<Name Id="#x23176003">W6003_FbInputsNotChangedWarning</Name>
				<DisplayName TxtId=""><![CDATA[[Event ID: 0x{0,X}] FB Inputs have not changed since last cycle.]]></DisplayName>
